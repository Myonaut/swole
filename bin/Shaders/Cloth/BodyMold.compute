// GPU equivalent of DeformVerticesJob
// Deforms vertices by adding deltas to base positions
[numthreads(256, 1, 1)]
void DeformVertices(uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;
    if (tid >= _VertexCount)
        return; 

    // DeformedVertices[tid] = BaseVertices[tid] + Deltas[deltasIndexOffset + tid].positionDelta
    _DeformedVerticesOutput[tid] = _BaseVertices[tid] + _Deltas[_DeltasIndexOffset + tid].positionDelta; 
}

// GPU equivalent of DeformVerticesWithShapeJob
// Deforms vertices by adding both regular deltas and shape deltas to base positions
[numthreads(256, 1, 1)]
void DeformVerticesWithShape(uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;
    if (tid >= _VertexCount)
        return;

    // DeformedVertices[tid] = BaseVertices[tid] + Deltas[deltasIndexOffset + tid].positionDelta + ShapeDeltas[shapeDeltasIndexOffset + tid].positionDelta
    _DeformedVerticesOutput[tid] = _BaseVertices[tid] 
        + _Deltas[_DeltasIndexOffset + tid].positionDelta 
        + _ShapeDeltas[_ShapeDeltasIndexOffset + tid].positionDelta;
}

// Stage 1: Each thread group processes a chunk of vertices and outputs partial bounds
#define BOUNDS_THREADS 256
groupshared BoundsMinMax sharedBounds[BOUNDS_THREADS];

[numthreads(BOUNDS_THREADS, 1, 1)]
void CalculateBounds(uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID, uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;
    uint localId = gtid.x;

    // Initialize thread-local bounds to extreme values
    float3 minPoint = float3(3.402823466e+37, 3.402823466e+37, 3.402823466e+37);
    float3 maxPoint = float3(-3.402823466e+37, -3.402823466e+37, -3.402823466e+37);

    // Each thread processes one vertex (if in range)
    if (tid < _DeformedVertexCount)
    {
        float3 pos = DeformedVertices[tid];
        minPoint = pos;
        maxPoint = pos;
    }

    // Store in shared memory
    sharedBounds[localId].minPoint = minPoint;
    sharedBounds[localId].maxPoint = maxPoint;
    GroupMemoryBarrierWithGroupSync();

    // Parallel reduction within thread group
    [unroll]
    for (uint stride = BOUNDS_THREADS / 2; stride > 0; stride >>= 1)
    {
        if (localId < stride)
        {
            sharedBounds[localId].minPoint = min(sharedBounds[localId].minPoint, sharedBounds[localId + stride].minPoint);
            sharedBounds[localId].maxPoint = max(sharedBounds[localId].maxPoint, sharedBounds[localId + stride].maxPoint);
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // First thread in group writes the partial result
    if (localId == 0)
    {
        PartialBounds[gid.x] = sharedBounds[0];
    }
}

// Stage 2: Final reduction of partial bounds from all thread groups
[numthreads(BOUNDS_THREADS, 1, 1)]
void CalculateBounds_Reduce(uint3 gtid : SV_GroupThreadID, uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;
    uint localId = gtid.x;

    // Calculate number of partial bounds (one per thread group from stage 1)
    uint numPartials = (_DeformedVertexCount + BOUNDS_THREADS - 1) / BOUNDS_THREADS;

    // Initialize thread-local bounds to extreme values
    float3 minPoint = float3(3.402823466e+37, 3.402823466e+37, 3.402823466e+37);
    float3 maxPoint = float3(-3.402823466e+37, -3.402823466e+37, -3.402823466e+37);

    // Each thread loads one partial bound (if in range)
    if (tid < numPartials)
    {
        BoundsMinMax partial = PartialBounds[tid];
        minPoint = partial.minPoint;
        maxPoint = partial.maxPoint;
    }

    // Store in shared memory
    sharedBounds[localId].minPoint = minPoint;
    sharedBounds[localId].maxPoint = maxPoint;
    GroupMemoryBarrierWithGroupSync();

    // Parallel reduction within thread group
    [unroll]
    for (uint stride = BOUNDS_THREADS / 2; stride > 0; stride >>= 1)
    {
        if (localId < stride)
        {
            sharedBounds[localId].minPoint = min(sharedBounds[localId].minPoint, sharedBounds[localId + stride].minPoint);
            sharedBounds[localId].maxPoint = max(sharedBounds[localId].maxPoint, sharedBounds[localId + stride].maxPoint);
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // First thread writes the final result
    if (localId == 0 && dtid.x == 0)
    {
        float3 finalMin = sharedBounds[0].minPoint;
        float3 finalMax = sharedBounds[0].maxPoint;
        float3 center = (finalMin + finalMax) * 0.5;
        float3 size = (finalMax - finalMin) * _PaddingScale;

        OutputBoundsMin[0] = center - size * 0.5;
        OutputBoundsMax[0] = center + size * 0.5;
        
        OutputBoundsMaxDistance[0] = length(size); 
    }
}

[numthreads(256,1,1)]
void BodyMold_VertexCloud(uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;
    
    uint id;
    uint idInBuffer;
    int4 bindIdx;
    float4 bindW;
    VertexData localBaseVertex;
    MeshVertexDelta prevRawOffset;
    MeshVertexDelta rawOffset;
    MeshVertexDelta origOffset;
    MeshVertexDelta finalOffset;
    float avgStretch = 1.0;
    float tightness = 1.0;
    float3 thicknessVector;
    if (!CalculateShapePreservingClothingVertexOffset(tid, id, idInBuffer, bindIdx, bindW, 1.0, localBaseVertex, prevRawOffset, rawOffset, origOffset, finalOffset, avgStretch, tightness, thicknessVector)) 
        return;

    // Vertex-cloud penetration handling along the motion segment (start -> end)
    {
        // iterate small number of internal passes to relax multi-triangle collisions
        int passes = max(1, _CollisionPasses);
        float relax = saturate(_CollisionRelaxation);
        for (int p = 0; p < passes; p++)
        {
            float3 worldStart = localBaseVertex.position + origOffset.positionDelta;
            float3 worldEnd = localBaseVertex.position + finalOffset.positionDelta;
            float3 seg = worldEnd - worldStart;
            float segLenSq = dot(seg, seg);

            float minDistSq = 1e30;
            float3 nearestPos = float3(0,0,0);
            float3 nearestClosest = float3(0,0,0);
            bool found = false;

            for (int i = 0; i < 4; i++)
            {
                int idx = (i==0)?bindIdx.x: (i==1)?bindIdx.y: (i==2)?bindIdx.z: bindIdx.w;
                float w = (i==0)?bindW.x: (i==1)?bindW.y: (i==2)?bindW.z: bindW.w;
                if (w <= 0.0) continue;
                if (idx < 0) continue;
                if (idx >= _BodyVertexCount) continue;

                float3 bpos = _BodyVertexPositions[idx] + SampleBodyDelta(idx).positionDelta;

                // Closest point on segment to bpos
                float t = 0.0;
                if (segLenSq > 1e-8)
                {
                    t = dot(bpos - worldStart, seg) / segLenSq;
                    t = clamp(t, 0.0, 1.0);
                }
                float3 closest = worldStart + seg * t;
                float3 diff = closest - bpos;
                float d2 = dot(diff, diff);
                if (d2 < minDistSq)
                {
                    minDistSq = d2;
                    nearestPos = bpos;
                    nearestClosest = closest;
                    found = true;
                }
            }

            if (!found) break;

            float dist = sqrt(minDistSq);
            if (dist < _PenetrationDistance && dist > 1e-6)
            {
                float needed = (_PenetrationDistance - dist) + _PenetrationRecovery;
                float3 pushDir = normalize(nearestClosest - nearestPos);
                if (all(pushDir == float3(0,0,0))) pushDir = float3(0,1,0);
                // Apply relaxed correction to end position
                float3 corr = pushDir * needed * relax;
                finalOffset.positionDelta += corr;
                // if correction is tiny, break early
                if (dot(corr, corr) < 1e-10) break;
            }
            else if (dist <= 1e-6)
            {
                float3 corr = float3(0, _PenetrationDistance + _PenetrationRecovery, 0) * relax;
                finalOffset.positionDelta += corr;
                if (dot(corr, corr) < 1e-10) break;
            }
            else
            {
                // no penetration this pass
                break;
            }
        }
    }

    WriteToClothingVertexDeltas(idInBuffer, finalOffset);
    _ClothingStretch[id] = avgStretch;
}

float3 CollideWithBodyTriangles(uint tid, uint clothingId, float thickness, VertexData localBaseVertex, MeshVertexDelta origOffset, inout MeshVertexDelta finalOffset, out bool foundTri, out bool anyFront)
{
    Triangles32 triBind = _NearbyTriangles[tid];
    foundTri = false;
    anyFront = false;

    uint bodyTriCount = 0;
    uint bodyTriStride = 0;
    _TargetTriangles.GetDimensions(bodyTriCount, bodyTriStride);

    float3 origWorldPos = localBaseVertex.position + origOffset.positionDelta;
    float3 worldPos = localBaseVertex.position + finalOffset.positionDelta;

    int connCount = _VertexConnectionCounts[clothingId];
    int connStart = _VertexConnectionStartIndices[clothingId];
    if (connCount <= 0)
        return worldPos;

    for (int i = 0; i < 32; i++)
    {
        //int triIndex =
        //(i == 0) ? triBind.trianglesA.x : (i == 1) ? triBind.trianglesA.y : (i == 2) ? triBind.trianglesA.z : (i == 3) ? triBind.trianglesA.w :
        //(i == 4) ? triBind.trianglesB.x : (i == 5) ? triBind.trianglesB.y : (i == 6) ? triBind.trianglesB.z : (i == 7) ? triBind.trianglesB.w :
        //(i == 8) ? triBind.trianglesC.x : (i == 9) ? triBind.trianglesC.y : (i == 10) ? triBind.trianglesC.z : (i == 11) ? triBind.trianglesC.w :
        //(i == 12) ? triBind.trianglesD.x : (i == 13) ? triBind.trianglesD.y : (i == 14) ? triBind.trianglesD.z : (i == 15) ? triBind.trianglesD.w :
        //(i == 16) ? triBind.trianglesE.x : (i == 17) ? triBind.trianglesE.y : (i == 18) ? triBind.trianglesE.z : (i == 19) ? triBind.trianglesE.w :
        //(i == 20) ? triBind.trianglesF.x : (i == 21) ? triBind.trianglesF.y : (i == 22) ? triBind.trianglesF.z : (i == 23) ? triBind.trianglesF.w :
        //(i == 24) ? triBind.trianglesG.x : (i == 25) ? triBind.trianglesG.y : (i == 26) ? triBind.trianglesG.z : (i == 27) ? triBind.trianglesG.w :
        //(i == 28) ? triBind.trianglesH.x : (i == 29) ? triBind.trianglesH.y : (i == 30) ? triBind.trianglesH.z : triBind.trianglesH.w;

        int triIndex = triBind.triangles[i];

        if (triIndex < 0)
            continue;
        if ((uint) triIndex >= bodyTriCount)
            continue;

        foundTri = true;

        int3 tri = _TargetTriangles[triIndex];
        float3 a = _BodyVertexPositions[tri.x] + SampleBodyDelta(tri.x).positionDelta;
        float3 b = _BodyVertexPositions[tri.y] + SampleBodyDelta(tri.y).positionDelta;
        float3 c = _BodyVertexPositions[tri.z] + SampleBodyDelta(tri.z).positionDelta;

        float3 triNormal = normalize(cross(b - a, c - a));
        float signedDist = dot(worldPos - a, triNormal);
        // consider cloth thickness when deciding if vertex is "in front" of the triangle
        bool localAbove = signedDist > thickness;
        if (localAbove)
            anyFront = true;

        float3 edge1 = b - a;
        float3 edge2 = c - a;

        // First: check if the motion segment (orig -> final) intersects the triangle; treat as strong penetration
        float3 motionDir = worldPos - origWorldPos;
        if (dot(motionDir, motionDir) >= 1e-12)
        {
            float3 h_m = cross(motionDir, edge2);
            float a_dot_m = dot(edge1, h_m);
            if (abs(a_dot_m) >= 1e-6)
            {
                float f_m = 1.0 / a_dot_m;
                float3 s_m = origWorldPos - a;
                float u_m = f_m * dot(s_m, h_m);
                if (u_m >= 0.0 && u_m <= 1.0)
                {
                    float3 q_m = cross(s_m, edge1);
                    float v_m = f_m * dot(motionDir, q_m);
                    if (v_m >= 0.0 && u_m + v_m <= 1.0)
                    {
                        float t_m = f_m * dot(edge2, q_m);
                        if (t_m >= 0.0 && t_m <= 1.0)
                        {
                            // Motion intersects triangle: push above skin
                            float3 proj = worldPos - triNormal * signedDist;
                            float3 target = proj + triNormal * (thickness + _PenetrationRecovery);
                            float pushFactor = 1.0;
                            float3 blended = lerp(worldPos, target, pushFactor);
                            finalOffset.positionDelta = blended - localBaseVertex.position;
                            worldPos = localBaseVertex.position + finalOffset.positionDelta;
                            return worldPos;
                        }
                    }
                }
            }
        }

        // Check neighbor segments for intersection. Count how many neighbors are below the triangle
        int belowCount = 0;
        int intersectCount = 0;
        for (int ci = 0; ci < connCount; ci++)
        {
            int neighbor = _VertexConnections[connStart + ci].index;
            if (neighbor < 0)
                continue;

            VertexData nb = SampleClothingVertexData(neighbor);
            MeshVertexDelta nbDelta = SampleClothingVertexDelta(neighbor, _IndexOffset);
            float3 p0 = nb.position + nbDelta.positionDelta;
            float3 dir = worldPos - p0;
            if (dot(dir, dir) < 1e-12)
                continue;

            float3 h = cross(dir, edge2);
            float a_dot = dot(edge1, h);
            if (abs(a_dot) < 1e-6)
                continue;
            float f = 1.0 / a_dot;
            float3 s = p0 - a;
            float u = f * dot(s, h);
            if (u < 0.0 || u > 1.0)
                continue;
            float3 q = cross(s, edge1);
            float v = f * dot(dir, q);
            if (v < 0.0 || u + v > 1.0)
                continue;
            float t = f * dot(edge2, q);
            if (t < 0.0 || t > 1.0)
                continue;

            // neighbor->local segment intersects triangle
            intersectCount++;
            float neighSigned = dot(p0 - a, triNormal);
            if (neighSigned <= thickness)
                belowCount++;
        }

        // If local is within thickness or behind and any neighbor intersects, apply full push
        if (!localAbove && intersectCount > 0)
        {
            float3 proj = worldPos - triNormal * signedDist;
            float3 target = proj + triNormal * (thickness + _PenetrationRecovery);
            float pushFactor = 1.0;
            float3 blended = lerp(worldPos, target, pushFactor);
            finalOffset.positionDelta = blended - localBaseVertex.position;
            worldPos = localBaseVertex.position + finalOffset.positionDelta;
            return worldPos;
        }

        // If local is above but some neighbors are below and intersect, push local up fractionally
        if (localAbove && belowCount > 0)
        {
            float frac = (float)belowCount / (float)connCount; // fraction of neighbors below
            float pushFactor = frac; //saturate(frac * _FrontPushFactor); // scaled by configured front push factor
            if (pushFactor > 1e-6)
            {
                float3 proj = worldPos - triNormal * signedDist;
                float3 target = proj + triNormal * (thickness + _PenetrationRecovery);
                float3 blended = lerp(worldPos, target, pushFactor);
                finalOffset.positionDelta = blended - localBaseVertex.position; 
                worldPos = localBaseVertex.position + finalOffset.positionDelta; 
                return worldPos;
            }
        }
    }

    return worldPos; 
}

// Triangle-on-triangle collision detection
// Uses clothing triangle topology (via _ClothingTriangles and connection.triIndex) to perform
// triangle-triangle intersection tests against nearby body triangles
float3 CollideWithBodyTriangles_TriangleBased(uint tid, uint clothingId, float thickness, VertexData localBaseVertex, MeshVertexDelta origOffset, inout MeshVertexDelta finalOffset, out bool foundTri, out bool anyFront)
{
    Triangles32 triBind = _NearbyTriangles[tid];
    foundTri = false;
    anyFront = false;

    uint bodyTriCount = 0;
    uint bodyTriStride = 0;
    _TargetTriangles.GetDimensions(bodyTriCount, bodyTriStride);

    float3 origWorldPos = localBaseVertex.position + origOffset.positionDelta;
    float3 worldPos = localBaseVertex.position + finalOffset.positionDelta;

    int connCount = _VertexConnectionCounts[clothingId];
    int connStart = _VertexConnectionStartIndices[clothingId];
    if (connCount <= 0)
        return worldPos;

    // Build list of unique clothing triangles connected to this vertex
    int clothingTriIndices[32];
    int clothingTriCount = 0;

    for (int ci = 0; ci < connCount && clothingTriCount < 32; ci++)
    {
        WeightedVertexConnection conn = _VertexConnections[connStart + ci];
        if (conn.triIndex < 0)
            continue;

        // Check if we already have this triangle
        bool alreadyAdded = false;
        for (int check = 0; check < clothingTriCount; check++)
        {
            if (clothingTriIndices[check] == conn.triIndex)
            {
                alreadyAdded = true;
                break;
            }
        }

        if (!alreadyAdded)
        {
            clothingTriIndices[clothingTriCount++] = conn.triIndex;
        }
    }

    // Calculate maximum connection distance for sanity checking
    float maxConnectionDist = 0.0;
    for (int ci = 0; ci < connCount; ci++)
    {
        int neighbor = _VertexConnections[connStart + ci].index;
        if (neighbor < 0)
            continue;

        VertexData nbBase = SampleClothingVertexData(neighbor);
        MeshVertexDelta nbDelta = SampleClothingVertexDelta(neighbor, _IndexOffset);
        float3 nbPos = nbBase.position + nbDelta.positionDelta;

        float connDist = length(nbPos - worldPos);
        maxConnectionDist = max(maxConnectionDist, connDist);
    }

    // Allow pushes up to 0.65x the longest connection distance
    // This prevents extreme pushes that would tear the mesh
    float maxAllowedPushDist = maxConnectionDist * 0.65;  

    // Track the minimal push needed to resolve all intersections
    float3 totalPushDir = float3(0, 0, 0);
    float maxPushDist = 0.0;
    int pushCount = 0;

    // Process each clothing triangle
    for (int cti = 0; cti < clothingTriCount; cti++)
    {
        int clothTriIdx = clothingTriIndices[cti];

        // triIndex is already premultiplied by 3, so use it directly as the base index
        int ci0 = _ClothingTriangles[clothTriIdx + 0];
        int ci1 = _ClothingTriangles[clothTriIdx + 1];
        int ci2 = _ClothingTriangles[clothTriIdx + 2];

        // Get deformed positions for clothing triangle
        VertexData cv0 = SampleClothingVertexData(ci0);
        VertexData cv1 = SampleClothingVertexData(ci1);
        VertexData cv2 = SampleClothingVertexData(ci2);

        MeshVertexDelta cd0 = SampleClothingVertexDelta(ci0, _IndexOffset);
        MeshVertexDelta cd1 = SampleClothingVertexDelta(ci1, _IndexOffset);
        MeshVertexDelta cd2 = SampleClothingVertexDelta(ci2, _IndexOffset);

        float3 cp0 = cv0.position + cd0.positionDelta;
        float3 cp1 = cv1.position + cd1.positionDelta;
        float3 cp2 = cv2.position + cd2.positionDelta;

        // NOTE: Do NOT override with current worldPos - creates temporal inconsistency
        // All three vertices should use the same buffer state (ReadOnly) for consistency
        // The local vertex will be at slightly stale position, but this prevents drift

        float3 clothEdge1 = cp1 - cp0;
        float3 clothEdge2 = cp2 - cp0;
        float3 clothNormal = SafeNormalize(cross(clothEdge1, clothEdge2));

        // Determine which vertex of the clothing triangle is the local one
        float dist0 = length(cp0 - worldPos);
        float dist1 = length(cp1 - worldPos);
        float dist2 = length(cp2 - worldPos);

        bool isVert0 = (dist0 < 0.001);
        bool isVert1 = (dist1 < 0.001);
        bool isVert2 = (dist2 < 0.001);

        // Only process triangles that contain the local vertex
        if (!isVert0 && !isVert1 && !isVert2)
            continue;

        // Check against nearby body triangles
        for (int i = 0; i < 32; i++)
        {
            //int triIndex =
            //(i == 0) ? triBind.trianglesA.x : (i == 1) ? triBind.trianglesA.y : (i == 2) ? triBind.trianglesA.z : (i == 3) ? triBind.trianglesA.w :
            //(i == 4) ? triBind.trianglesB.x : (i == 5) ? triBind.trianglesB.y : (i == 6) ? triBind.trianglesB.z : (i == 7) ? triBind.trianglesB.w :
            //(i == 8) ? triBind.trianglesC.x : (i == 9) ? triBind.trianglesC.y : (i == 10) ? triBind.trianglesC.z : (i == 11) ? triBind.trianglesC.w :
            //(i == 12) ? triBind.trianglesD.x : (i == 13) ? triBind.trianglesD.y : (i == 14) ? triBind.trianglesD.z : (i == 15) ? triBind.trianglesD.w :
            //(i == 16) ? triBind.trianglesE.x : (i == 17) ? triBind.trianglesE.y : (i == 18) ? triBind.trianglesE.z : (i == 19) ? triBind.trianglesE.w :
            //(i == 20) ? triBind.trianglesF.x : (i == 21) ? triBind.trianglesF.y : (i == 22) ? triBind.trianglesF.z : (i == 23) ? triBind.trianglesF.w :
            //(i == 24) ? triBind.trianglesG.x : (i == 25) ? triBind.trianglesG.y : (i == 26) ? triBind.trianglesG.z : (i == 27) ? triBind.trianglesG.w :
            //(i == 28) ? triBind.trianglesH.x : (i == 29) ? triBind.trianglesH.y : (i == 30) ? triBind.trianglesH.z : triBind.trianglesH.w;

            int triIndex = triBind.triangles[i];

            if (triIndex < 0 || (uint)triIndex >= bodyTriCount)
                continue;

            foundTri = true;

            // Get body triangle vertices
            int3 tri = _TargetTriangles[triIndex];
            float3 a = _BodyVertexPositions[tri.x] + SampleBodyDelta(tri.x).positionDelta;
            float3 b = _BodyVertexPositions[tri.y] + SampleBodyDelta(tri.y).positionDelta;
            float3 c = _BodyVertexPositions[tri.z] + SampleBodyDelta(tri.z).positionDelta;

            float3 triNormal = SafeNormalize(cross(b - a, c - a));

            // Test all three clothing vertices against this body triangle
            float3 clothVerts[3] = { cp0, cp1, cp2 };
            float minPenetration = 1000.0;
            bool anyPenetrating = false;

            for (int vi = 0; vi < 3; vi++)
            {
                float signedDist = dot(clothVerts[vi] - a, triNormal);

                // Check if vertex is inside body triangle using barycentric coords
                float3 v0 = b - a;
                float3 v1 = c - a;
                float3 v2 = clothVerts[vi] - a;

                float d00 = dot(v0, v0);
                float d01 = dot(v0, v1);
                float d11 = dot(v1, v1);
                float d20 = dot(v2, v0);
                float d21 = dot(v2, v1);

                float denom = d00 * d11 - d01 * d01;
                if (abs(denom) > 1e-8)
                {
                    float bary_v = (d11 * d20 - d01 * d21) / denom;
                    float bary_w = (d00 * d21 - d01 * d20) / denom;
                    float bary_u = 1.0 - bary_v - bary_w;

                    // If vertex projects inside triangle and is too close or penetrating
                    if (bary_u >= -0.05 && bary_v >= -0.05 && bary_w >= -0.05 && 
                        bary_u <= 1.05 && bary_v <= 1.05 && bary_w <= 1.05)
                    {
                        if (signedDist < thickness)
                        {
                            anyPenetrating = true;
                            minPenetration = min(minPenetration, signedDist);
                            anyFront = anyFront || (signedDist > 0);
                        }
                    }
                }
            }

            // Also check edge-edge intersections for a more robust test
            bool hasIntersection = false;

            // Check each edge of the clothing triangle
            for (int edgeIdx = 0; edgeIdx < 3; edgeIdx++)
            {
                float3 edgeStart = clothVerts[edgeIdx];
                float3 edgeEnd = clothVerts[(edgeIdx + 1) % 3];
                float3 edgeDir = edgeEnd - edgeStart;

                float startDist = dot(edgeStart - a, triNormal);
                float endDist = dot(edgeEnd - a, triNormal);

                // Check if edge crosses the body triangle plane
                if ((startDist > 0 && endDist < 0) || (startDist < 0 && endDist > 0))
                {
                    // Calculate intersection point with plane
                    float t = startDist / (startDist - endDist);
                    float3 planePoint = edgeStart + (edgeEnd - edgeStart) * t;

                    // Check if intersection point is inside the body triangle using barycentric coordinates
                    float3 v0 = b - a;
                    float3 v1 = c - a;
                    float3 v2 = planePoint - a;

                    float d00 = dot(v0, v0);
                    float d01 = dot(v0, v1);
                    float d11 = dot(v1, v1);
                    float d20 = dot(v2, v0);
                    float d21 = dot(v2, v1);

                    float denom = d00 * d11 - d01 * d01;
                    if (abs(denom) > 1e-8)
                    {
                        float bary_v = (d11 * d20 - d01 * d21) / denom;
                        float bary_w = (d00 * d21 - d01 * d20) / denom;
                        float bary_u = 1.0 - bary_v - bary_w;

                        // Check if point is inside triangle
                        if (bary_u >= -0.01 && bary_v >= -0.01 && bary_w >= -0.01 && 
                            bary_u <= 1.01 && bary_v <= 1.01 && bary_w <= 1.01)
                        {
                            hasIntersection = true;

                            // For edge intersections, we care about the closest endpoint's distance
                            // Don't use the average, as that can be misleading when edge crosses the plane
                            float closestEdgeDist = (abs(startDist) < abs(endDist)) ? startDist : endDist;

                            // Only update minPenetration if this is actually close/penetrating
                            if (abs(closestEdgeDist) < thickness)
                            {
                                anyPenetrating = true;
                                minPenetration = min(minPenetration, closestEdgeDist);
                            }
                        }
                    }
                }
            }

            // If any vertex is penetrating or intersecting, accumulate the push
            if (anyPenetrating || hasIntersection)
            {
                // Calculate minimal push distance to clear thickness
                // minPenetration represents the closest distance (negative = penetrating, positive = above)
                float requiredPushDist;

                if (minPenetration < 0)
                {
                    // Penetrating: push out by the penetration depth + thickness + recovery
                    requiredPushDist = -minPenetration + thickness + _PenetrationRecovery;
                }
                else if (minPenetration < thickness)
                {
                    // Above surface but too close: push out to reach thickness
                    requiredPushDist = thickness - minPenetration + _PenetrationRecovery;
                }
                else
                {
                    // Already at safe distance, no push needed
                    requiredPushDist = 0.0;
                }

                if (requiredPushDist > 0.0)
                {
                    // Accumulate push in the body triangle normal direction
                    totalPushDir += triNormal;
                    maxPushDist = max(maxPushDist, requiredPushDist);
                    pushCount++;
                }
            }
        }
    }

    // Apply the accumulated minimal push to resolve all intersections
    if (pushCount > 0 && maxPushDist > 0.0)
    {
        // Sanity check: reject pushes that would stretch connections beyond reasonable limits
        // This prevents extreme spikes when collision detection goes wrong
        if (maxAllowedPushDist > 0.0 && maxPushDist > maxAllowedPushDist)
        {
            // Push is too large - would tear the mesh
            // Either skip it entirely, or clamp it
            maxPushDist = maxAllowedPushDist;
        }

        // Average the push direction from all colliding triangles
        float3 avgPushDir = SafeNormalize(totalPushDir);

        // Apply the minimal push needed to clear all intersections
        float3 pushOffset = avgPushDir * maxPushDist;
        finalOffset.positionDelta += pushOffset;
        worldPos = localBaseVertex.position + finalOffset.positionDelta; 
    }

    return worldPos; 
}

// Triangle-based collision kernel: uses per-vertex bound triangles and the body triangle list to compute closest points.
[numthreads(256,1,1)]
void BodyMold_Triangle(uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;
    
    uint id;
    uint idInBuffer;
    int4 bindIdx;
    float4 bindW;
    VertexData localBaseVertex;
    MeshVertexDelta prevRawOffset;
    MeshVertexDelta rawOffset;
    MeshVertexDelta origOffset;
    MeshVertexDelta finalOffset;
    float avgStretch = 1.0;
    float tightness = 1.0;
    float3 thicknessVector;
    if (!CalculateShapePreservingClothingVertexOffset(tid, id, idInBuffer, bindIdx, bindW, 1.0, localBaseVertex, prevRawOffset, rawOffset, origOffset, finalOffset, avgStretch, tightness, thicknessVector)) 
        return;

    localBaseVertex.position = localBaseVertex.position - thicknessVector;
    
    bool foundTri;
    bool anyFront;
    float3 worldPos = CollideWithBodyTriangles_TriangleBased(tid, id, 0.0, localBaseVertex, origOffset, finalOffset, foundTri, anyFront);
    bool foundTri2;
    bool anyFront2;
    worldPos = CollideWithBodyTriangles(tid, id, 0.0, localBaseVertex, origOffset, finalOffset, foundTri2, anyFront2);
    //SmoothConnectionDivergence(id, localBaseVertex, finalOffset, _FrontPushFactor);
    
    WriteToClothingVertexDeltas(idInBuffer, finalOffset);
    _ClothingStretch[id] = avgStretch;
}

// The baked 3D SDF Texture passed from C#
Texture3D<float> _BodySDFTex;
SamplerState sampler_BodySDFTex;

Texture3D<float> _BodySDFTexSimplified;
SamplerState sampler_BodySDFTexSimplified;

void CollideWithSDF_Precombined(Texture3D<float> sdfTexture, float thickness, float3 combinedVertex, float innerPushStrength, float outerPushStrength, inout MeshVertexDelta finalOffset)
{
    float3 pos = combinedVertex;

    // 1. Calculate UVW (Normalized 0.0 to 1.0 float values inside the box)
    float3 uvw = (pos - _SDFBoundsMin) / (_SDFBoundsMax - _SDFBoundsMin);

    // 2. Safety Check: Only collide if the cloth vertex is inside the volume box
    if (all(uvw >= 0.0) && all(uvw <= 1.0))
    {
        // 3. Convert UVW float coordinates to exact 3D Integer Voxel Coordinates
        // We use clamp to ensure rounding errors don't overshoot the texture arrays
        int3 voxelCoords = clamp(int3(uvw * (_SDFResolution - 1)), int3(0, 0, 0), int3(_SDFResolution - 1, _SDFResolution - 1, _SDFResolution - 1));

        // 4. Read the exact distance value out of the 3D texture
        float distanceToSkin = sdfTexture[voxelCoords];

        // 5. If the vertex is piercing the body or inside the thickness margin, resolve it
        if (distanceToSkin < thickness)
        {
            float penetrationDepth = thickness - distanceToSkin;

            // 6. Calculate Gradient vector manually via integer step offsets
            // This replaces the automated filtering hardware standard shaders use
            int3 offsetX = int3(1, 0, 0);
            int3 offsetY = int3(0, 1, 0);
            int3 offsetZ = int3(0, 0, 1);

            // Read neighboring voxel cells safely clamped inside limits
            float posX = sdfTexture[clamp(voxelCoords + offsetX, 0, _SDFResolution - 1)];
            float negX = sdfTexture[clamp(voxelCoords - offsetX, 0, _SDFResolution - 1)];
            
            float posY = sdfTexture[clamp(voxelCoords + offsetY, 0, _SDFResolution - 1)];
            float negY = sdfTexture[clamp(voxelCoords - offsetY, 0, _SDFResolution - 1)];
            
            float posZ = sdfTexture[clamp(voxelCoords + offsetZ, 0, _SDFResolution - 1)];
            float negZ = sdfTexture[clamp(voxelCoords - offsetZ, 0, _SDFResolution - 1)];

            // The directional slope pointing directly away from the center of the body mesh
            float3 outwardDirection = normalize(float3(posX - negX, posY - negY, posZ - negZ)); 

            // 7. Push the cloth vertex out of the body bounds instantly
            finalOffset.positionDelta += outwardDirection * penetrationDepth * lerp(innerPushStrength, outerPushStrength, saturate(penetrationDepth / thickness));
        }
    }
}

void CollideWithSDF_Precombined2(Texture3D<float> sdfTexture, SamplerState sdfSampler, float thickness, float3 combinedVertex, float innerPushStrength, float outerPushStrength, inout MeshVertexDelta finalOffset, float3 localBaseNormal)
{
    float3 pos = combinedVertex;

    // 1. Calculate UVW
    float3 uvw = (pos - _SDFBoundsMin) / (_SDFBoundsMax - _SDFBoundsMin);

    // 2. Safety Check
    if (all(uvw >= 0.0) && all(uvw <= 1.0))
    {
        // 3. Smoothly sample using trilinear filtering hardware
        // This provides sub-voxel distance precision
        float distanceToSkin = sdfTexture.SampleLevel(sdfSampler, uvw, 0).r;

        // 4. Check penetration
        if (distanceToSkin < thickness)
        {
            float penetrationDepth = thickness - distanceToSkin;

            // 5. Calculate Gradient using float UVW steps (1 voxel wide)
            float step = 1.0 / (float) _SDFResolution;
            
            float posX = sdfTexture.SampleLevel(sdfSampler, uvw + float3(step, 0, 0), 0).r;
            float negX = sdfTexture.SampleLevel(sdfSampler, uvw - float3(step, 0, 0), 0).r;
            
            float posY = sdfTexture.SampleLevel(sdfSampler, uvw + float3(0, step, 0), 0).r;
            float negY = sdfTexture.SampleLevel(sdfSampler, uvw - float3(0, step, 0), 0).r;
            
            float posZ = sdfTexture.SampleLevel(sdfSampler, uvw + float3(0, 0, step), 0).r;
            float negZ = sdfTexture.SampleLevel(sdfSampler, uvw - float3(0, 0, step), 0).r;

            float3 gradient = float3(posX - negX, posY - negY, posZ - negZ); 
            float3 outwardDirection;

            // 6. Fail-Safe: Check if the gradient is corrupted/flat
            if (length(gradient) > 0.0001)
            {
                outwardDirection = normalize(gradient);
            }
            else
            {
                // Deep field fallback: Use the original vertex normal to push outward
                outwardDirection = localBaseNormal;
            }

            // 7. Dynamic Escape Force
            // If the vertex is deep inside (negative distance), we multiply the push strength 
            // exponentially to violently reject it from the core of the body mesh.
            float deepMultiplier = (distanceToSkin < 0.0) ? (1.0 + abs(distanceToSkin) * innerPushStrength) : 1.0;
            
            float finalPush = penetrationDepth * deepMultiplier * outerPushStrength;
            
            finalOffset.positionDelta += outwardDirection * finalPush;
        }
    }
}

void CollideWithSDF_Precombined3(Texture3D<float> sdfTexture, SamplerState sdfSampler, float thickness, float3 combinedVertex, float innerPushStrength, float outerPushStrength, inout MeshVertexDelta finalOffset, float3 localBaseNormal)
{
    float3 pos = combinedVertex;

    // 1. Calculate UVW
    float3 uvw = (pos - _SDFBoundsMin) / (_SDFBoundsMax - _SDFBoundsMin);

    // 2. Safety Check
    if (all(uvw >= 0.0) && all(uvw <= 1.0))
    {
        // 3. Smoothly sample using trilinear filtering hardware
        float distanceToSkin = sdfTexture.SampleLevel(sdfSampler, uvw, 0).r;

        // 4. Check penetration
        if (distanceToSkin < thickness)
        {
            float penetrationDepth = thickness - distanceToSkin;

            // 5. Calculate Gradient using float UVW steps (1 voxel wide)
// Calculate a dynamic sampling offset
// If we are deep inside, we expand the search radius to peek past local voxel noise
            float baseStep = 1.0 / (float) _SDFResolution;
            float dynamicRadius = baseStep * (distanceToSkin < 0.0 ? (1.0 + abs(distanceToSkin) * 10.0) : 1.0);

// Tetrahedral sampling offsets (mathematically balanced 4-tap structure)
            float3 e0 = float3(1.0, -1.0, -1.0) * dynamicRadius;
            float3 e1 = float3(-1.0, -1.0, 1.0) * dynamicRadius;
            float3 e2 = float3(-1.0, 1.0, -1.0) * dynamicRadius;
            float3 e3 = float3(1.0, 1.0, 1.0) * dynamicRadius;

            float d0 = sdfTexture.SampleLevel(sdfSampler, uvw + e0, 0).r;
            float d1 = sdfTexture.SampleLevel(sdfSampler, uvw + e1, 0).r;
            float d2 = sdfTexture.SampleLevel(sdfSampler, uvw + e2, 0).r;
            float d3 = sdfTexture.SampleLevel(sdfSampler, uvw + e3, 0).r;

// Reconstruct the analytical escape gradient vector
            float3 gradient = e0 * d0 + e1 * d1 + e2 * d2 + e3 * d3;
            float3 outwardDirection;

            if (length(gradient) > 0.0001)
            {
                outwardDirection = normalize(gradient);
            }
            else
            {
    // Fall back strictly to the cloth vertex normal if we are dead center
                outwardDirection = localBaseNormal;
            }

            // FIX 2: Check for degenerate or nearly flat gradients dynamically
            // When deep inside, the SDF slope drops significantly.
            if (length(gradient) > 0.001 && distanceToSkin > -0.05)
            {
                outwardDirection = normalize(gradient);
            }
            else
            {
                // CRITICAL ESCAPE RAY: If the gradient vanishes, we MUST use the vertex normal.
                outwardDirection = localBaseNormal;
                
                // If we are deep inside and the gradient failed us, we enforce a massive escape step
                if (distanceToSkin <= -0.05)
                {
                    penetrationDepth = thickness + abs(distanceToSkin) + 0.02; // Force out by an extra 2cm
                }
            }

            // 6. Dynamic Escape Force
            float deepMultiplier = (distanceToSkin < 0.0) ? (1.0 + abs(distanceToSkin) * innerPushStrength) : 1.0;
            float finalPush = penetrationDepth * deepMultiplier * outerPushStrength;
            
            // 7. IMPENETRABLE RESOLUTION (The Fix)
            // Instead of compounding an additive push force that fights the smoothing solver,
            // we project the displacement vector onto the outward direction.
            float3 correctionVector = outwardDirection * finalPush;
            
            // If the incoming delta is pushing *into* the collision surface, 
            // we cancel out that inward velocity entirely so it can't fight the push force.
            float incomingInwardForce = dot(finalOffset.positionDelta, outwardDirection);
            if (incomingInwardForce < 0.0)
            {
                // Strip away the inward component of the cloth solver's movement
                finalOffset.positionDelta -= outwardDirection * incomingInwardForce;
            }

            // Apply the absolute spatial correction 
            finalOffset.positionDelta += correctionVector; 
        }
    }
}

void CollideWithSDF_Precombined4(
    Texture3D<float> sdfTexture,
    SamplerState sdfSampler,
    float thickness,
    float3 prePullVertex, // Position BEFORE the cloth pull pass
    float3 combinedVertex, // Position AFTER the cloth pull pass
    float innerPushStrength,
    float outerPushStrength,
    inout MeshVertexDelta finalOffset,
    float3 localBaseNormal)
{
    float3 pos = combinedVertex;

    // 1. Calculate UVW for the current post-pull position
    float3 uvw = (pos - _SDFBoundsMin) / (_SDFBoundsMax - _SDFBoundsMin);

    // 2. Out-of-bounds safety check
    if (all(uvw >= 0.0) && all(uvw <= 1.0))
    {
        // 3. Sample distance field at the destination point
        float distanceToSkin = sdfTexture.SampleLevel(sdfSampler, uvw, 0).r;

        // 4. If the cloth solver pulled us past the allowed thickness boundary
        if (distanceToSkin < thickness)
        {
            

            // 5. Calculate the local SDF Gradient direction
// Calculate a dynamic sampling offset
// If we are deep inside, we expand the search radius to peek past local voxel noise
            float baseStep = 1.0 / (float) _SDFResolution;
            float dynamicRadius = baseStep * (distanceToSkin < 0.0 ? (1.0 + abs(distanceToSkin) * 10.0) : 1.0);

// Tetrahedral sampling offsets (mathematically balanced 4-tap structure)
            float3 e0 = float3(1.0, -1.0, -1.0) * dynamicRadius;
            float3 e1 = float3(-1.0, -1.0, 1.0) * dynamicRadius;
            float3 e2 = float3(-1.0, 1.0, -1.0) * dynamicRadius;
            float3 e3 = float3(1.0, 1.0, 1.0) * dynamicRadius;

            float d0 = sdfTexture.SampleLevel(sdfSampler, uvw + e0, 0).r;
            float d1 = sdfTexture.SampleLevel(sdfSampler, uvw + e1, 0).r;
            float d2 = sdfTexture.SampleLevel(sdfSampler, uvw + e2, 0).r;
            float d3 = sdfTexture.SampleLevel(sdfSampler, uvw + e3, 0).r;

// Reconstruct the analytical escape gradient vector
            float3 gradient = e0 * d0 + e1 * d1 + e2 * d2 + e3 * d3;
            float3 outwardDirection;

            if (length(gradient) > 0.0001)
            {
                outwardDirection = normalize(gradient);
            }
            else
            {
    // Fall back strictly to the cloth vertex normal if we are dead center
                outwardDirection = localBaseNormal;
            }

            // ==========================================
            // IMPENETRABLE VELOCITY PROJECTION (THE FIX)
            // ==========================================
            
            // Calculate the actual travel vector the cloth solver tried to make this step
            float3 pullTravelVector = combinedVertex - prePullVertex;

            // Project the travel vector onto the collision normal to see how hard it's pushing inward
            float inwardPenetrationSpeed = dot(pullTravelVector, outwardDirection);

            if (inwardPenetrationSpeed < 0.0)
            {
                // STRIP INWARD MOMENTUM: Cancel out 100% of the vector trying to push into the body.
                // This stops the cloth solver from overpowering the collision engine.
                finalOffset.positionDelta -= outwardDirection * inwardPenetrationSpeed;
            }

            // Calculate exact space needed to push back out to the surface skin + thickness
            float penetrationDepth = thickness - distanceToSkin;
            float deepMultiplier = (distanceToSkin < 0.0) ? (1.0 + abs(distanceToSkin) * innerPushStrength) : 1.0;
            
            // Hard snap: Multiply by outerPushStrength (keep at 1.0 for a perfect surface snap)
            float3 pushBackVector = outwardDirection * (penetrationDepth * deepMultiplier * outerPushStrength);

            // Apply the absolute spatial correction
            finalOffset.positionDelta += pushBackVector;
        }
    }
}

Texture3D<float> _BodyVDFTex;
SamplerState sampler_BodyVDFTex;

Texture3D<float> _BodyVDFTexSimplified;
SamplerState sampler_BodyVDFTexSimplified;

void CollideWithVDF_Impenetrable(
    Texture3D<float4> vdfTexture, // Texture format: RGBAFloat or RGBAHalf
    SamplerState vdfSampler,
    float thickness,
    float3 combinedVertex, // Current position with cloth offset applied
    inout MeshVertexDelta finalOffset)
{
    float3 pos = combinedVertex;

    // 1. Calculate UVW coordinate
    float3 uvw = (pos - _SDFBoundsMin) / (_SDFBoundsMax - _SDFBoundsMin);

    // 2. Safety Bounds Check
    if (all(uvw >= 0.0) && all(uvw <= 1.0))
    {
        // 3. Sample the Vector Distance Field in a single texture call
        float4 vdfSample = vdfTexture.SampleLevel(vdfSampler, uvw, 0);
        
        // RGB = Pre-calculated direction vector pointing straight out to the closest surface point
        float3 escapeDirection = vdfSample.xyz;
        
        // A = Signed Distance (Negative inside the body, positive outside)
        float distanceToSkin = vdfSample.w;

        // 4. Check if the vertex has penetrated the safety thickness threshold
        if (distanceToSkin < thickness)
        {
            // 5. Un-cheatable Escape Normal
            // If the sample vector is corrupted or zero, use a hard default fallback, 
            // but a true baked VDF vector will never be zero unless perfectly at the center core.
            float vecLength = length(escapeDirection);
            if (vecLength > 0.001)
            {
                escapeDirection = escapeDirection / vecLength;
            }
            else
            {
                return; // Safely skip if completely dead core center
            }

            // 6. Absolute Positional Correction
            // Calculate exactly how many meters we need to travel along the escape vector 
            // to sit precisely at the safe outer skin shell + thickness boundary.
            float requiredPushDistance = thickness - distanceToSkin;

            // 7. HARD RESET RESOLUTION
            // Instead of compounding additive velocity forces that fight your high-speed 
            // over-relaxed cloth solver, we forcefully overwrite the offset.
            // We subtract the inward movement vector that crossed the line, 
            // then append the absolute spatial push back out.
            float inwardVelocity = dot(finalOffset.positionDelta, escapeDirection);
            
            if (inwardVelocity < 0.0)
            {
                // Kill the cloth solver's inward momentum entirely
                finalOffset.positionDelta -= escapeDirection * inwardVelocity;
            }

            // Snap the vertex cleanly out to the impenetrable surface boundary
            finalOffset.positionDelta += escapeDirection * requiredPushDistance;
        }
    }
}

// Texture 1 (Core Mapping): RGB = Bone Core Anchor, A = Safe Distance to Skin Mesh
Texture3D<float4> _BodyCoreTexture;
// Texture 2 (Surface Direction): RGB = True Skin Normal Vector at the target boundary, A = Unused
Texture3D<float4> _BodySurfaceNormalTexture;

SamplerState sampler_BodyCoreTexture;

void CollideWithAnisotropicCoreVolume(
    float3 prePullVertex, // Position BEFORE the over-relaxed cloth pull pass
    float3 combinedVertex, // Position AFTER the over-relaxed cloth pull pass
    float thickness,
    inout MeshVertexDelta finalOffset,
    float3 localBaseNormal)       // The clothing vertex's own normal vector
{
    float3 pos = combinedVertex;

    // 1. Map current vertex position to the volume's UVW bounds
    float3 uvw = (pos - _SDFBoundsMin) / (_SDFBoundsMax - _SDFBoundsMin);

    if (all(uvw >= 0.0) && all(uvw <= 1.0))
    {
        // 2. Fetch the pre-baked core anchor and target surface orientation
        float4 coreSample = _BodyCoreTexture.SampleLevel(sampler_BodyCoreTexture, uvw, 0);
        float3 coreAnchor = coreSample.xyz;
        float safeRadius = coreSample.w;

        float3 targetSkinNormal = _BodySurfaceNormalTexture.SampleLevel(sampler_BodyCoreTexture, uvw, 0).xyz;

        // 3. ANGLE-BASED ESCAPE RESOLUTION
        // Calculate the vector pointing from the deep bone core out to our current vertex position
        float3 coreToVertexVec = pos - coreAnchor;
        float coreDistance = length(coreToVertexVec);

        // Standard radial fallback direction
        float3 radialDirection = (coreDistance > 0.001) ? (coreToVertexVec / coreDistance) : localBaseNormal;

        // Blending the radial vector with the true target surface normal.
        // This resolves concavities (like armpits): if the vertex pushes deep, 
        // it is forced out along the opening angle of the crevice, not just sideways into the arm/torso walls.
        float3 escapeDirection = normalize(radialDirection + targetSkinNormal);

        // 4. CHOOSE THE MOST CONSERVATIVE PENETRATION DEPTH
        // Measure depth two ways: radially from the core, and lineally along the surface normal
        float radialPenetration = safeRadius - coreDistance;
        
        // This dot product detects if the vertex has crossed "under" the skin surface plane
        float surfacePenetration = thickness - dot(coreToVertexVec, targetSkinNormal);

        // If either check indicates we are inside, we trigger a hard collision
        if (coreDistance < safeRadius || surfacePenetration > 0.0)
        {
            // Pick the deepest required escape distance to guarantee complete ejection
            float finalPenetrationDepth = max(radialPenetration, surfacePenetration) + thickness;

            // 5. ISOLATE AND ELIMINATE CLOTH SOLVER VELOCITY
            // Find the exact trajectory your hyper-boosted cloth pull pass calculated this frame
            float3 pullTravelVector = combinedVertex - prePullVertex;
            
            // Check if that movement vector was fighting our exit path
            float inwardVelocity = dot(pullTravelVector, escapeDirection);

            if (inwardVelocity < 0.0)
            {
                // Erase 100% of the cloth solver's inward trajectory.
                // This breaks the feedback loop completely, freezing the vertex on the hull boundary.
                finalOffset.positionDelta -= escapeDirection * inwardVelocity;
            }

            // 6. ABSOLUTE PENETRATION REJECTION
            // Forcefully snap the vertex to the safe outer shell plus the desired thickness gap
            finalOffset.positionDelta += escapeDirection * finalPenetrationDepth; 
        }
    }
}

void CollideWithSDF(Texture3D<float> sdfTexture, float thickness, VertexData localBaseVertex, float innerPushStrength, float outerPushStrength, inout MeshVertexDelta finalOffset)
{
    CollideWithSDF_Precombined(sdfTexture, thickness, localBaseVertex.position + finalOffset.positionDelta, innerPushStrength, outerPushStrength, finalOffset);
}

[numthreads(256, 1, 1)]
void BodyMold_SDF(uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;
    
    uint id;
    uint idInBuffer;
    int4 bindIdx;
    float4 bindW;
    VertexData localBaseVertex;
    MeshVertexDelta prevRawOffset;
    MeshVertexDelta rawOffset;
    MeshVertexDelta origOffset;
    MeshVertexDelta finalOffset;
    float avgStretch = 1.0;
    float tightness = 1.0;
    float3 thicknessVector;
    if (!CalculateShapePreservingClothingVertexOffset(tid, id, idInBuffer, bindIdx, bindW, 1.0, localBaseVertex, prevRawOffset, rawOffset, origOffset, finalOffset, avgStretch, tightness, thicknessVector)) 
        return;
    
    MeshVertexDelta finalOffset2 = finalOffset;
    CalculateClothVertexOffset(tid, id, idInBuffer, bindIdx, bindW, localBaseVertex, origOffset, finalOffset2);
    
    finalOffset.positionDelta = lerp(finalOffset2.positionDelta, finalOffset.positionDelta, tightness); 
    
    localBaseVertex.position = localBaseVertex.position - thicknessVector;
    
    CollideWithSDF(_BodySDFTex, 0.005 * avgStretch, localBaseVertex, 1.0, _SDFOuterThicknessStrength, finalOffset);
    //SmoothConnectionDivergence(id, localBaseVertex, finalOffset, _FrontPushFactor * 0.5);
    
    WriteToClothingVertexDeltas(idInBuffer, finalOffset);
    _ClothingStretch[id] = avgStretch;
}

// Triangle collision with SDF fallback: prefer triangle collision; when vertex not in front of any triangle use SDF texture collision
[numthreads(256, 1, 1)]
void BodyMold_TriangleSDF(uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;

    uint id;
    uint idInBuffer;
    int4 bindIdx;
    float4 bindW;
    VertexData localBaseVertex;
    MeshVertexDelta prevRawOffset;
    MeshVertexDelta rawOffset;
    MeshVertexDelta origOffset;
    MeshVertexDelta finalOffset;
    float avgStretch = 1.0;
    float tightness = 1.0;
    float3 thicknessVector;
    if (!CalculateShapePreservingClothingVertexOffset(tid, id, idInBuffer, bindIdx, bindW, 0.01, localBaseVertex, prevRawOffset, rawOffset, origOffset, finalOffset, avgStretch, tightness, thicknessVector))
        return;
    
    localBaseVertex.position = localBaseVertex.position - thicknessVector;   
    
    bool foundTri;
    bool anyFront;
    float3 worldPos = CollideWithBodyTriangles_TriangleBased(tid, id, 0.0, localBaseVertex, origOffset, finalOffset, foundTri, anyFront);
    bool foundTri2;
    bool anyFront2;
    worldPos = CollideWithBodyTriangles(tid, id, 0.0, localBaseVertex, origOffset, finalOffset, foundTri2, anyFront2);  
    foundTri = foundTri || foundTri2;
    anyFront = anyFront || anyFront2; 
    
    float3 origWorldPos = localBaseVertex.position + rawOffset.positionDelta;
    
    MeshVertexDelta finalOffset2 = finalOffset;
    //CollideWithAnisotropicCoreVolume(origWorldPos, worldPos, 0.005 * avgStretch, finalOffset2, localBaseVertex.normal);
    CollideWithSDF_Precombined3(_BodySDFTex, sampler_BodySDFTex, 0.005 * avgStretch, worldPos, 1.0, _SDFOuterThicknessStrength, finalOffset2, localBaseVertex.normal); 
    //if (tightness < 0.92)
    //{
    //    MeshVertexDelta finalOffset3 = finalOffset2;
    //    worldPos = localBaseVertex.position + finalOffset2.positionDelta;
    //    CollideWithSDF_Precombined3(_BodySDFTex, sampler_BodySDFTex, 0.005 * avgStretch, worldPos, 1.0, 0.05, finalOffset3, localBaseVertex.normal);
    //    finalOffset2 = MVD_Lerp(finalOffset3, finalOffset2, tightness); 
    //}
    if (foundTri && anyFront)
    {
        finalOffset = MVD_Lerp(finalOffset2, finalOffset, tightness);
    }
    else
    {
        finalOffset = finalOffset2;
    }

    WriteToClothingVertexDeltas(idInBuffer, finalOffset);
    _ClothingStretch[id] = avgStretch;
}

[numthreads(256, 1, 1)]
void BodyMoldCloth_TriangleSDF(uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;
    
    uint id;
    uint idInBuffer;
    GetClothingIds(tid, id, idInBuffer);
    if (id >= _VertexCount)
        return;
    
    float4 vColor = _ClothingVertexColors[id];
    float tightness = vColor.y; // 0 = loose (bridge), 1 = tight (wrap)
    float stretch = _ClothingStretch[id];
    
    VertexData localBaseVertex = SampleClothingVertexData(id);
    localBaseVertex.normal = normalize(localBaseVertex.normal);
    localBaseVertex.tangent.xyz = normalize(localBaseVertex.tangent.xyz);
    
    MeshVertexDelta origOffset = SampleClothingVertexDelta(id, _IndexOffset);
    MeshVertexDelta finalOffset = origOffset; 
    
    float3 origWorldPos = localBaseVertex.position + origOffset.positionDelta; 
    
    ApplyClothPullPass(id, localBaseVertex, finalOffset, 0.0, 1.0 / max(1.0, LengthSqr(finalOffset.positionDelta)), stretch);
    
    float thickness = stretch * _ClothThickness;
    float3 currentNormal = normalize(localBaseVertex.normal + finalOffset.normalDelta);  
    float3 thicknessVector = currentNormal * thickness;
    //localBaseVertex.position = localBaseVertex.position + thicknessVector;
    
    float3 worldPos = localBaseVertex.position + finalOffset.positionDelta;
    MeshVertexDelta finalOffset2 = finalOffset;
    //CollideWithAnisotropicCoreVolume(origWorldPos, worldPos, 0.001 * stretch, finalOffset2, localBaseVertex.normal);
    CollideWithSDF_Precombined3(_BodySDFTex, sampler_BodySDFTex, thickness, worldPos, 1.0, _SDFOuterThicknessStrengthCloth, finalOffset2, currentNormal);

    finalOffset2.positionDelta = finalOffset2.positionDelta - thicknessVector; 
    bool foundTri;
    bool anyFront;
    CollideWithBodyTriangles_TriangleBased(tid, id, 0.0, localBaseVertex, origOffset, finalOffset2, foundTri, anyFront);
    bool foundTri2;
    bool anyFront2;
    CollideWithBodyTriangles(tid, id, 0.0, localBaseVertex, origOffset, finalOffset2, foundTri2, anyFront2);  
    finalOffset2.positionDelta = finalOffset2.positionDelta + thicknessVector; 
    
    finalOffset = MVD_Lerp(finalOffset2, origOffset, tightness); 
     
    WriteToClothingVertexDeltas(idInBuffer, finalOffset);
}


[numthreads(256, 1, 1)]
void BodyMold_RecalculateNormals(uint3 dtid : SV_DispatchThreadID)
{
    uint tid = dtid.x;

    uint id;
    uint idInBuffer;
    GetClothingIds(tid, id, idInBuffer);
    if (id >= _VertexCount)
        return;
    
    int connCount = _VertexConnectionCounts[id];
    int connStart = _VertexConnectionStartIndices[id];
    if (connCount <= 0)
        return;

    MeshVertexDelta finalOffset = SampleClothingVertexDelta(id, _IndexOffset);
    
    VertexData localBaseVertex = SampleClothingVertexData(id);
    float3 localPos = localBaseVertex.position + finalOffset.positionDelta; 
    float3 localNormal = localBaseVertex.normal;
    
    float3 normalDelta = float3(0,0,0);
    float w = 0.0;
    for (int ci = 0; ci < connCount; ci += 2)
    {
        int neighborA = _VertexConnections[connStart + ci].index;
        int neighborB = _VertexConnections[connStart + ci + 1].index;
        if (neighborA < 0 || neighborB < 0)
            continue;

        VertexData nbBaseA = SampleClothingVertexData(neighborA);
        MeshVertexDelta nbDeltaA = SampleClothingVertexDelta(neighborA, _IndexOffset);
        float3 nbPosA = nbBaseA.position + nbDeltaA.positionDelta;
        
        VertexData nbBaseB = SampleClothingVertexData(neighborB);
        MeshVertexDelta nbDeltaB = SampleClothingVertexDelta(neighborB, _IndexOffset);
        float3 nbPosB = nbBaseB.position + nbDeltaB.positionDelta;
        
        float3 n = cross(nbPosA - localPos, nbPosB - localPos); 
        if (dot(n, localNormal) < 0.0)
            n = -n;
        
        normalDelta += n;
        
        w += 1.0;
    }
    
    normalDelta = normalize(normalDelta / max(w, 1.0)) - localNormal;
    finalOffset.normalDelta = lerp(finalOffset.normalDelta, normalDelta, _NormalRecalculationBlend);
    
    _ClothingVertexDeltas[idInBuffer] = finalOffset; // raw write into buffer to avoid writing into proxy normals
}

// Adjust clothing skin bindings based on closest body triangle
// Uses barycentric interpolation of body vertex skin bindings
[numthreads(256, 1, 1)]
void AdjustSkinBindings(uint3 dtid : SV_DispatchThreadID) 
{
    uint tid = dtid.x;

    // Get clothing vertex index
    uint clothingId = tid;
    if (_ClothingVertexIndexCount > 0)
    {
        if (tid >= (uint)_ClothingVertexIndexCount)
            return;
        clothingId = _BindingLocalIndices[tid];
    }
    else if (tid >= _VertexCount)
        return;

    //uint idInBuffer = clothingId + _IndexOffset;

    // Get clothing vertex deformed position
    VertexData localBaseVertex = SampleClothingVertexData(clothingId);
    MeshVertexDelta clothingDelta = SampleClothingVertexDelta(clothingId, _IndexOffset);
    float3 clothingPos = localBaseVertex.position + clothingDelta.positionDelta;

    // Get nearby triangles
    Triangles32 triBind = _NearbyTriangles[tid];

    uint bodyTriCount = 0;
    uint bodyTriStride = 0;
    _TargetTriangles.GetDimensions(bodyTriCount, bodyTriStride);

    // Find closest body triangle
    float minDistSq = 1e10;
    int closestTriIndex = -1;
    float3 closestPoint = float3(0, 0, 0);
    float3 closestBaryCoords = float3(0, 0, 0);

    for (int i = 0; i < 32; i++)
    {
        //int triIndex =
        //(i == 0) ? triBind.trianglesA.x : (i == 1) ? triBind.trianglesA.y : (i == 2) ? triBind.trianglesA.z : (i == 3) ? triBind.trianglesA.w :
        //(i == 4) ? triBind.trianglesB.x : (i == 5) ? triBind.trianglesB.y : (i == 6) ? triBind.trianglesB.z : (i == 7) ? triBind.trianglesB.w :
        //(i == 8) ? triBind.trianglesC.x : (i == 9) ? triBind.trianglesC.y : (i == 10) ? triBind.trianglesC.z : (i == 11) ? triBind.trianglesC.w :
        //(i == 12) ? triBind.trianglesD.x : (i == 13) ? triBind.trianglesD.y : (i == 14) ? triBind.trianglesD.z : (i == 15) ? triBind.trianglesD.w :
        //(i == 16) ? triBind.trianglesE.x : (i == 17) ? triBind.trianglesE.y : (i == 18) ? triBind.trianglesE.z : (i == 19) ? triBind.trianglesE.w :
        //(i == 20) ? triBind.trianglesF.x : (i == 21) ? triBind.trianglesF.y : (i == 22) ? triBind.trianglesF.z : (i == 23) ? triBind.trianglesF.w :
        //(i == 24) ? triBind.trianglesG.x : (i == 25) ? triBind.trianglesG.y : (i == 26) ? triBind.trianglesG.z : (i == 27) ? triBind.trianglesG.w :
        //(i == 28) ? triBind.trianglesH.x : (i == 29) ? triBind.trianglesH.y : (i == 30) ? triBind.trianglesH.z : triBind.trianglesH.w;

        int triIndex = triBind.triangles[i];
        
        if (triIndex < 0 || (uint)triIndex >= bodyTriCount)
            continue;

        // Get body triangle vertices with deltas applied
        int3 tri = _TargetTriangles[triIndex];
        float3 a = _BodyVertexPositions[tri.x] + SampleBodyDelta(tri.x).positionDelta;
        float3 b = _BodyVertexPositions[tri.y] + SampleBodyDelta(tri.y).positionDelta;
        float3 c = _BodyVertexPositions[tri.z] + SampleBodyDelta(tri.z).positionDelta;

        // Find closest point on triangle to clothing vertex
        float3 edge0 = b - a;
        float3 edge1 = c - a;
        float3 edge2 = c - b;

        float3 v = clothingPos - a;

        float d00 = dot(edge0, edge0);
        float d01 = dot(edge0, edge1);
        float d11 = dot(edge1, edge1);
        float d20 = dot(v, edge0);
        float d21 = dot(v, edge1);

        float denom = d00 * d11 - d01 * d01;

        float3 baryCoords;
        float3 pointOnTri;

        if (abs(denom) > 1e-8)
        {
            float bary_v = (d11 * d20 - d01 * d21) / denom;
            float bary_w = (d00 * d21 - d01 * d20) / denom;
            float bary_u = 1.0 - bary_v - bary_w;

            // Clamp barycentric coordinates to triangle (project to closest point on triangle if outside)
            if (bary_u >= 0 && bary_v >= 0 && bary_w >= 0)
            {
                // Inside triangle
                baryCoords = float3(bary_u, bary_v, bary_w);
                pointOnTri = a * bary_u + b * bary_v + c * bary_w;
            }
            else
            {
                // Outside triangle - find closest edge or vertex
                float3 candidates[3];
                float distsSq[3];

                // Edge AB
                float t0 = saturate(dot(clothingPos - a, edge0) / d00);
                candidates[0] = a + edge0 * t0;
                distsSq[0] = dot(clothingPos - candidates[0], clothingPos - candidates[0]);

                // Edge AC
                float t1 = saturate(dot(clothingPos - a, edge1) / d11);
                candidates[1] = a + edge1 * t1;
                distsSq[1] = dot(clothingPos - candidates[1], clothingPos - candidates[1]);

                // Edge BC
                float t2 = saturate(dot(clothingPos - b, edge2) / dot(edge2, edge2));
                candidates[2] = b + edge2 * t2;
                distsSq[2] = dot(clothingPos - candidates[2], clothingPos - candidates[2]);

                // Find closest
                int closestEdge = 0;
                if (distsSq[1] < distsSq[closestEdge]) closestEdge = 1;
                if (distsSq[2] < distsSq[closestEdge]) closestEdge = 2;

                pointOnTri = candidates[closestEdge];

                // Calculate barycentric coords for closest point
                if (closestEdge == 0) // Edge AB
                {
                    baryCoords = float3(1.0 - t0, t0, 0);
                }
                else if (closestEdge == 1) // Edge AC
                {
                    baryCoords = float3(1.0 - t1, 0, t1);
                }
                else // Edge BC
                {
                    baryCoords = float3(0, 1.0 - t2, t2);
                }
            }
        }
        else
        {
            // Degenerate triangle - use closest vertex
            float distASq = dot(clothingPos - a, clothingPos - a);
            float distBSq = dot(clothingPos - b, clothingPos - b);
            float distCSq = dot(clothingPos - c, clothingPos - c);

            if (distASq <= distBSq && distASq <= distCSq)
            {
                pointOnTri = a;
                baryCoords = float3(1, 0, 0);
            }
            else if (distBSq <= distCSq)
            {
                pointOnTri = b;
                baryCoords = float3(0, 1, 0);
            }
            else
            {
                pointOnTri = c;
                baryCoords = float3(0, 0, 1);
            }
        }

        float distSq = dot(clothingPos - pointOnTri, clothingPos - pointOnTri);

        if (distSq < minDistSq)
        {
            minDistSq = distSq;
            closestTriIndex = triIndex;
            closestPoint = pointOnTri;
            closestBaryCoords = baryCoords;
        }
    }

    // If no valid triangle found, keep original bindings
    if (closestTriIndex < 0)
    {
        _SkinBindings[clothingId] = _SkinBindingsReadOnly[clothingId];
        return;
    }

    // Get the three body vertices of the closest triangle
    int3 tri = _TargetTriangles[closestTriIndex];
    SkinInfluence skinA = _BodySkinBindings[tri.x];
    SkinInfluence skinB = _BodySkinBindings[tri.y];
    SkinInfluence skinC = _BodySkinBindings[tri.z];

    // Collect all bone influences from the three vertices (up to 24 bones total: 3 vertices × 8 bones each)
    // We need to accumulate weights for each unique bone index using barycentric interpolation

    // Use a simple array to store bone index/weight pairs (max 24 entries)
    int boneIndices[24];
    float boneWeights[24];
    int boneCount = 0;

    // Helper arrays for the three vertices
    int indicesPerVertex[3][8];
    float weightsPerVertex[3][8];

    // Vertex A
    indicesPerVertex[0][0] = (int)skinA.indicesA.x; weightsPerVertex[0][0] = skinA.weightsA.x;
    indicesPerVertex[0][1] = (int)skinA.indicesA.y; weightsPerVertex[0][1] = skinA.weightsA.y;
    indicesPerVertex[0][2] = (int)skinA.indicesA.z; weightsPerVertex[0][2] = skinA.weightsA.z;
    indicesPerVertex[0][3] = (int)skinA.indicesA.w; weightsPerVertex[0][3] = skinA.weightsA.w;
    indicesPerVertex[0][4] = (int)skinA.indicesB.x; weightsPerVertex[0][4] = skinA.weightsB.x;
    indicesPerVertex[0][5] = (int)skinA.indicesB.y; weightsPerVertex[0][5] = skinA.weightsB.y;
    indicesPerVertex[0][6] = (int)skinA.indicesB.z; weightsPerVertex[0][6] = skinA.weightsB.z;
    indicesPerVertex[0][7] = (int)skinA.indicesB.w; weightsPerVertex[0][7] = skinA.weightsB.w;

    // Vertex B
    indicesPerVertex[1][0] = (int)skinB.indicesA.x; weightsPerVertex[1][0] = skinB.weightsA.x;
    indicesPerVertex[1][1] = (int)skinB.indicesA.y; weightsPerVertex[1][1] = skinB.weightsA.y;
    indicesPerVertex[1][2] = (int)skinB.indicesA.z; weightsPerVertex[1][2] = skinB.weightsA.z;
    indicesPerVertex[1][3] = (int)skinB.indicesA.w; weightsPerVertex[1][3] = skinB.weightsA.w;
    indicesPerVertex[1][4] = (int)skinB.indicesB.x; weightsPerVertex[1][4] = skinB.weightsB.x;
    indicesPerVertex[1][5] = (int)skinB.indicesB.y; weightsPerVertex[1][5] = skinB.weightsB.y;
    indicesPerVertex[1][6] = (int)skinB.indicesB.z; weightsPerVertex[1][6] = skinB.weightsB.z;
    indicesPerVertex[1][7] = (int)skinB.indicesB.w; weightsPerVertex[1][7] = skinB.weightsB.w;

    // Vertex C
    indicesPerVertex[2][0] = (int)skinC.indicesA.x; weightsPerVertex[2][0] = skinC.weightsA.x;
    indicesPerVertex[2][1] = (int)skinC.indicesA.y; weightsPerVertex[2][1] = skinC.weightsA.y;
    indicesPerVertex[2][2] = (int)skinC.indicesA.z; weightsPerVertex[2][2] = skinC.weightsA.z;
    indicesPerVertex[2][3] = (int)skinC.indicesA.w; weightsPerVertex[2][3] = skinC.weightsA.w;
    indicesPerVertex[2][4] = (int)skinC.indicesB.x; weightsPerVertex[2][4] = skinC.weightsB.x;
    indicesPerVertex[2][5] = (int)skinC.indicesB.y; weightsPerVertex[2][5] = skinC.weightsB.y;
    indicesPerVertex[2][6] = (int)skinC.indicesB.z; weightsPerVertex[2][6] = skinC.weightsB.z;
    indicesPerVertex[2][7] = (int)skinC.indicesB.w; weightsPerVertex[2][7] = skinC.weightsB.w;

    // Barycentric weights for the three vertices
    float baryWeights[3] = { closestBaryCoords.x, closestBaryCoords.y, closestBaryCoords.z };

    // Accumulate bone weights from all three vertices
    for (int vi = 0; vi < 3; vi++)
    {
        for (int bi = 0; bi < 8; bi++)
        {
            int boneIdx = indicesPerVertex[vi][bi];
            float weight = weightsPerVertex[vi][bi] * baryWeights[vi];

            // Skip invalid or zero-weight bones
            if (boneIdx < 0 || weight < 1e-6)
                continue;

            // Check if this bone already exists in our list
            bool found = false;
            for (int existing = 0; existing < boneCount; existing++)
            {
                if (boneIndices[existing] == boneIdx)
                {
                    boneWeights[existing] += weight;
                    found = true;
                    break;
                }
            }

            // Add new bone if not found and we have space
            if (!found && boneCount < 24)
            {
                boneIndices[boneCount] = boneIdx;
                boneWeights[boneCount] = weight;
                boneCount++;
            }
        }
    }

    // If no valid bones found, keep original
    if (boneCount == 0)
    {
        _SkinBindings[clothingId] = _SkinBindingsReadOnly[clothingId];
        return;
    }

    // Sort bones by weight (descending) using simple bubble sort (good enough for small arrays)
    // We only need the top 8, so we can optimize by only sorting what we need
    for (int i = 0; i < min(8, boneCount); i++)
    {
        for (int j = i + 1; j < boneCount; j++)
        {
            if (boneWeights[j] > boneWeights[i])
            {
                // Swap weights
                float tempWeight = boneWeights[i]; 
                boneWeights[i] = boneWeights[j];
                boneWeights[j] = tempWeight;

                // Swap indices
                int tempIndex = boneIndices[i];
                boneIndices[i] = boneIndices[j];
                boneIndices[j] = tempIndex;
            }
        }
    }

    // Take the top 8 bones and normalize their weights
    float totalWeight = 0.0;
    for (int i = 0; i < min(8, boneCount); i++)
    {
        totalWeight += boneWeights[i];
    }

    if (totalWeight < 1e-6)
    {
        // Fallback: no valid weights, keep original
        _SkinBindings[clothingId] = _SkinBindingsReadOnly[clothingId];
        return;
    }

    float invTotal = 1.0 / totalWeight;

    // Build the result
    SkinInfluence result;

    // Fill in the top 8 bones (or fewer if boneCount < 8)
    result.indicesA.x = (boneCount > 0) ? (float)boneIndices[0] : 0.0;
    result.indicesA.y = (boneCount > 1) ? (float)boneIndices[1] : 0.0;
    result.indicesA.z = (boneCount > 2) ? (float)boneIndices[2] : 0.0;
    result.indicesA.w = (boneCount > 3) ? (float)boneIndices[3] : 0.0;
    result.indicesB.x = (boneCount > 4) ? (float)boneIndices[4] : 0.0;
    result.indicesB.y = (boneCount > 5) ? (float)boneIndices[5] : 0.0;
    result.indicesB.z = (boneCount > 6) ? (float)boneIndices[6] : 0.0;
    result.indicesB.w = (boneCount > 7) ? (float)boneIndices[7] : 0.0;

    result.weightsA.x = (boneCount > 0) ? boneWeights[0] * invTotal : 0.0;
    result.weightsA.y = (boneCount > 1) ? boneWeights[1] * invTotal : 0.0;
    result.weightsA.z = (boneCount > 2) ? boneWeights[2] * invTotal : 0.0;
    result.weightsA.w = (boneCount > 3) ? boneWeights[3] * invTotal : 0.0;
    result.weightsB.x = (boneCount > 4) ? boneWeights[4] * invTotal : 0.0;
    result.weightsB.y = (boneCount > 5) ? boneWeights[5] * invTotal : 0.0;
    result.weightsB.z = (boneCount > 6) ? boneWeights[6] * invTotal : 0.0;
    result.weightsB.w = (boneCount > 7) ? boneWeights[7] * invTotal : 0.0;

    _SkinBindings[clothingId] = result;
}

// Push back handling

void CalculateLiveVertexData(uint instanceId, uint vertexIndex, uint vertexCount, uint boneCount, StructuredBuffer<VertexData> baseDataBuffer, MeshVertexDelta delta, StructuredBuffer<SkinInfluence> skinningData, StructuredBuffer<float4x4> skinningMatrices, RWStructuredBuffer<VertexData> outputBuffer)
{
    uint vertexBufferIndex = vertexIndex + instanceId * vertexCount; 
    
    SkinInfluence si = skinningData[vertexIndex];
	
    const int boneIndexOffset = instanceId * boneCount; 
    float4x4 blendedMatrix =
	mul(skinningMatrices[boneIndexOffset + int(si.indicesA.x)], si.weightsA.x)
	+ mul(skinningMatrices[boneIndexOffset + int(si.indicesA.y)], si.weightsA.y)
	+ mul(skinningMatrices[boneIndexOffset + int(si.indicesA.z)], si.weightsA.z)
	+ mul(skinningMatrices[boneIndexOffset + int(si.indicesA.w)], si.weightsA.w)
	+ mul(skinningMatrices[boneIndexOffset + int(si.indicesB.x)], si.weightsB.x)
	+ mul(skinningMatrices[boneIndexOffset + int(si.indicesB.y)], si.weightsB.y)
	+ mul(skinningMatrices[boneIndexOffset + int(si.indicesB.z)], si.weightsB.z)
    + mul(skinningMatrices[boneIndexOffset + int(si.indicesB.w)], si.weightsB.w);

    VertexData output = baseDataBuffer[vertexIndex];
    output.position = mul(blendedMatrix, float4(output.position + delta.positionDelta, 1)).xyz;
    output.normal = mul(blendedMatrix, float4(normalize(output.normal + delta.normalDelta), 0)).xyz;
    output.tangent.xyz = mul(blendedMatrix, float4(normalize(output.tangent.xyz + delta.tangentDelta), 0)).xyz;
    
    outputBuffer[vertexIndex] = output;
}

StructuredBuffer<float4x4> _SkinningMatrices;

StructuredBuffer<VertexData> _LiveBodyVertexData;
StructuredBuffer<VertexData> _LiveClothVertexData;

// Pre-baked Topological Maps
StructuredBuffer<PushBackVertex> _AnchorMap;

RWStructuredBuffer<VertexData> _OutputVertexData;
RWStructuredBuffer<MeshVertexDelta> _PushBackDeltas;

[numthreads(256, 1, 1)]
void PrepareLiveVertexData(uint3 id : SV_DispatchThreadID)
{
    uint vertexIndex = id.x;
    if (vertexIndex >= _VertexCount)
        return;
    
    MeshVertexDelta delta = _Deltas[vertexIndex];
#if USE_PROXY_NORMAL_DELTAS
    delta.normalDelta = _ClothingProxyNormalDeltasReadOnly[vertexIndex];
#endif
    CalculateLiveVertexData(_InstanceID, vertexIndex, _VertexCount, _BoneCount, _LiveBodyVertexData, delta, _SkinBindingsReadOnly, _SkinningMatrices, _OutputVertexData);  
}

[numthreads(64, 1, 1)]
void PushBackBodyFromClothing(uint3 id : SV_DispatchThreadID)
{
    uint maskIdx = id.x;
    if ((int) maskIdx >= _VertexCount)
        return;

    PushBackVertex anchor = _AnchorMap[maskIdx];
    uint targetBodyIdx = anchor.vertexIndex;
    if (targetBodyIdx >= _BodyVertexCount)
        return;

    VertexData liveBodyData = _LiveBodyVertexData[targetBodyIdx];
    float3 finalPushedPos = liveBodyData.position;

    uint clothTriCount = 0;
    uint clothTriStride = 0;
    _TargetTriangles.GetDimensions(clothTriCount, clothTriStride);
    
    // Hard unrolled vector matrix processing
    [unroll]
    for (int i = 0; i < 32; i++)
    {
        int triIndex = anchor.pushBackTriangles[i];
        if (triIndex < 0 || (uint) triIndex >= clothTriCount)
            continue;
        
        // Get clothing triangle vertices
        int3 clothTri = _TargetTriangles[triIndex];
        
        int clothVertIdx = clothTri.x; // just use the first vertex

        VertexData clothVertexData = _LiveClothVertexData[clothVertIdx];

        // 1. Vector from clothing vertex to the body vertex
        float3 toBody = liveBodyData.position - clothVertexData.position;

        // 2. Fast Radius Gate: If the body vertex is horizontally too far away from this
        // specific clothing node, skip the expensive plane calculations completely.
        float sqrDistance = dot(toBody, toBody);
        if (sqrDistance > 0.04)
            continue; // 20cm bounding cutoff radius

        // 3. Project distance strictly along the live clothing normal line
        float depthDistance = dot(toBody, clothVertexData.normal);

        // --- THE TARGET CONDITION ---
        // If depthDistance > 0, it means the body vertex has physically crossed the plane 
        // of the clothing normal and is protruding on the outside profile.
        if (depthDistance > 0.0)
        {
            // Calculate target tuck position (push it behind the plane + 2mm safety gap)
            float3 safeTuckPoint = liveBodyData.position - (clothVertexData.normal * (depthDistance + 0.002));

            // If multiple tracking nodes register a clash, keep the deepest internal tuck
            if (dot(safeTuckPoint - liveBodyData.position, clothVertexData.normal) < dot(finalPushedPos - liveBodyData.position, clothVertexData.normal))
            {
                finalPushedPos = safeTuckPoint;
            }
        }
    }

    MeshVertexDelta delta;
    delta.positionDelta = finalPushedPos - liveBodyData.position; 
    delta.normalDelta = float3(0, 0, 0);
    delta.tangentDelta = float3(0, 0, 0);
    
    // debug
    //delta.positionDelta = liveBodyData.position;
    //delta.normalDelta = liveBodyData.normal;
    //delta.tangentDelta = liveBodyData.tangent.xyz;
    
    _PushBackDeltas[targetBodyIdx] = delta;

}