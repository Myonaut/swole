#include "SkinnedMeshData.hlsl"

StructuredBuffer<VertexData> _ClothingBaseVertexData;
StructuredBuffer<MeshVertexDelta> _ClothingVertexDeltasReadOnly;
RWStructuredBuffer<MeshVertexDelta> _ClothingVertexDeltas;
StructuredBuffer<float3> _ClothingProxyNormalDeltasReadOnly;
RWStructuredBuffer<float3> _ClothingProxyNormalDeltas;
StructuredBuffer<int> _ClothingTriangles;
RWStructuredBuffer<float> _ClothingStretch;
StructuredBuffer<float4> _ClothingVertexColors;
StructuredBuffer<uint> _ClothingVertexWeld;

StructuredBuffer<SkinInfluence> _SkinBindingsReadOnly;
RWStructuredBuffer<SkinInfluence> _SkinBindings;

StructuredBuffer<float3> _BodyVertexPositions;
StructuredBuffer<float3> _BodyVertexNormals;
StructuredBuffer<MeshVertexDelta> _BodyDeltas;
StructuredBuffer<MeshVertexDelta> _BodyPreviousDeltas;
StructuredBuffer<int3> _TargetTriangles; // optional triangle list (i0,i1,i2)
StructuredBuffer<SkinInfluence> _BodySkinBindings;

StructuredBuffer<WeightedVertexConnection> _VertexConnections; // flattened connection entries
StructuredBuffer<int> _VertexConnectionCounts; // per-vertex connection count
StructuredBuffer<int> _VertexConnectionStartIndices; // per-vertex start index into _VertexConnections

StructuredBuffer<int> _BindingLocalIndices; // the clothing vertex indices to process
StructuredBuffer<int4> _BindingIndices;
StructuredBuffer<float4> _BindingWeights;
// Optional nearby triangles per clothing vertex (up to 32) (if using triangle collision mode)
StructuredBuffer<Triangles32> _NearbyTriangles;

StructuredBuffer<float3> DeformedVertices; // input vertex positions
RWStructuredBuffer<BoundsMinMax> PartialBounds; // per-thread-group partial bounds
RWStructuredBuffer<float3> OutputBoundsMin; // final min point
RWStructuredBuffer<float3> OutputBoundsMax; // final max point
RWStructuredBuffer<float> OutputBoundsMaxDistance; // final max distance

// Deform vertices buffers (for SDF generation and bounds calculation)
StructuredBuffer<float3> _BaseVertices; // base mesh vertex positions
StructuredBuffer<MeshVertexDelta> _Deltas; // deltas to apply
StructuredBuffer<MeshVertexDelta> _ShapeDeltas; // optional shape deltas
RWStructuredBuffer<float3> _DeformedVerticesOutput; // output deformed positions
int _DeltasIndexOffset; // offset into _Deltas buffer
int _ShapeDeltasIndexOffset; // offset into _ShapeDeltas buffer (if used)

//cbuffer Params
//{
    float _PreserveFactor;
    float _PenetrationDistance; // minimum allowed distance from body vertex
    float _PenetrationRecovery; // extra push-out distance when penetration detected
    //float _MaxOffset; // clamp for maximum offset magnitude
    float _DeltaMultiplier; // multiplier for body deltas (for exaggerated effects)
    float _FrontPushFactor; // 0..1 how much to lerp toward front-projection when starting behind (per-iteration)
    float _ClothThickness;
    float _CollisionRelaxation; // 0..1 relaxation factor applied to each correction (lower -> softer)
    float _SDFOuterThicknessStrength;
    float _SDFOuterThicknessStrengthCloth;
    float _NormalRecalculationBlend; // 0..1 how much to blend between original and recalculated normals
    int _InstanceID;
    int _CollisionPasses; // number of internal collision resolve passes
    int _BodyVertexCount;
    int _BodyDeltasChanged; // 1 if this dispatch is the first after body update; used to apply delta diffs once.
    int _ClothingVertexIndexCount; // if >0 use _ClothingVertexIndices mapping
    int _SDFResolution; // e.g., 64
    int _IndexOffset;
    int _FirstRun; // 1 if this is the first run of the simulation (used to apply initial shape deltas from body to clothing)
    int _BoneCount;
    uint _VertexCount;
    float3 _SDFBoundsMin;
    float3 _SDFBoundsMax;
    float _PaddingScale; // scale factor for bounds size
    uint _DeformedVertexCount; // total number of vertices for bounds calculation
//}

VertexData SampleClothingVertexData(uint vertexIndex)
{
    vertexIndex = _ClothingVertexWeld[vertexIndex];
    return _ClothingBaseVertexData[vertexIndex];
}
float3 SampleClothingVertexPositionDelta(uint vertexIndex, uint vertexIndexOffset)
{
    vertexIndex = _ClothingVertexWeld[vertexIndex] + vertexIndexOffset;
    return _ClothingVertexDeltasReadOnly[vertexIndex].positionDelta;
}
MeshVertexDelta SampleClothingVertexDelta(uint vertexIndex, uint vertexIndexOffset)
{
    vertexIndex = _ClothingVertexWeld[vertexIndex] + vertexIndexOffset;
    MeshVertexDelta delta = _ClothingVertexDeltasReadOnly[vertexIndex];
#if USE_PROXY_NORMAL_DELTAS
    delta.normalDelta = _ClothingProxyNormalDeltasReadOnly[vertexIndex];
#endif
    return delta;
}
void WriteToClothingVertexDeltas(uint idInBuffer, MeshVertexDelta delta)
{
    _ClothingVertexDeltas[idInBuffer] = delta; 
#if USE_PROXY_NORMAL_DELTAS
    _ClothingProxyNormalDeltas[idInBuffer] = delta.normalDelta;
#endif
}

MeshVertexDelta SampleBodyDelta(uint idInBuffer)
{
    MeshVertexDelta delta = _BodyDeltas[idInBuffer];
    if (_DeltasIndexOffset >= 0)
        delta = MVD_Add(delta, _Deltas[_DeltasIndexOffset + idInBuffer]);
    return delta;
}
MeshVertexDelta SamplePreviousBodyDelta(uint idInBuffer)
{
    if (_FirstRun)
    {
        MeshVertexDelta delta;
        delta.positionDelta = float3(0, 0, 0);
        delta.normalDelta = float3(0, 0, 0);
        delta.tangentDelta = float3(0, 0, 0);
        return delta;
    }
    
    MeshVertexDelta delta = _BodyPreviousDeltas[idInBuffer];
    if (_DeltasIndexOffset >= 0)
        delta = MVD_Add(delta, _Deltas[_DeltasIndexOffset + idInBuffer]);
    return delta;
}

// Smoothing pass based on connection divergence.
// Compares directions to connected neighbors and smooths the vertex position toward
// the average neighbor position proportionally to the measured divergence.
// - clothingId: clothing vertex index
// - localBaseVertex: base vertex data for this clothing vertex
// - finalOffset: current offset (in/out)
// - smoothingStrength: user/tunable factor (0..1) controlling smoothing magnitude
void SmoothConnectionDivergence(uint clothingId, in VertexData localBaseVertex, inout MeshVertexDelta finalOffset, float smoothingStrength)
{
    int connCount = _VertexConnectionCounts[clothingId];
    if (connCount <= 0) return;
    int connStart = _VertexConnectionStartIndices[clothingId];

    float3 localWorld = localBaseVertex.position + finalOffset.positionDelta;

    // accumulate neighbor directions and positions
    float3 sumDir = float3(0,0,0);
    float3 sumPos = float3(0,0,0);
    int valid = 0;
    for (int i = 0; i < connCount; i++)
    {
        int n = _VertexConnections[connStart + i].index;
        if (n < 0) continue;
        VertexData nb = SampleClothingVertexData(n);
        MeshVertexDelta nbDelta = SampleClothingVertexDelta(n, _IndexOffset);
        float3 nbPos = nb.position + nbDelta.positionDelta;
        float3 dir = SafeNormalize(nbPos - localWorld);
        // skip degenerate neighbor directions
        if (all(dir == float3(0,0,0))) continue;
        sumDir += dir;
        sumPos += nbPos;
        valid++;
    }
    if (valid == 0) return;

    // Build an average normal from local + connected neighbor base normals
    float3 sumNormal = SafeNormalize(localBaseVertex.normal);
    for (int i = 0; i < connCount; i++)
    {
        int n = _VertexConnections[connStart + i].index;
        if (n < 0) continue;
        VertexData nbBase = SampleClothingVertexData(n);
        sumNormal += SafeNormalize(nbBase.normal);
    }
    float3 avgNormal = SafeNormalize(sumNormal);

    // Compare original and current connection directions in the tangent plane defined by avgNormal
    float alignSum = 0.0;
    int alignCount = 0;
    for (int i = 0; i < connCount; i++)
    {
        int n = _VertexConnections[connStart + i].index;
        if (n < 0) continue;
        VertexData nbBase = SampleClothingVertexData(n);
        MeshVertexDelta nbDelta = SampleClothingVertexDelta(n, _IndexOffset);
        float3 nbPos = nbBase.position + nbDelta.positionDelta;

        float3 origDir = SafeNormalize(nbBase.position - localBaseVertex.position);
        float3 currDir = SafeNormalize(nbPos - localWorld);
        if (all(origDir == float3(0,0,0)) || all(currDir == float3(0,0,0))) continue;

        // project onto tangent plane
        float3 origT = SafeNormalize(origDir - avgNormal * dot(origDir, avgNormal));
        float3 currT = SafeNormalize(currDir - avgNormal * dot(currDir, avgNormal));
        if (all(origT == float3(0,0,0)) || all(currT == float3(0,0,0))) continue; 

        alignSum += saturate(dot(origT, currT));
        alignCount++;
    }

    float avgAlign = (alignCount > 0) ? (alignSum / alignCount) : 1.0;
    // divergence 0..1 (0 = unchanged connectivity directions in tangent plane, 1 = fully divergent)
    float divergence = saturate(1.0 - avgAlign);
    // compute smoothing amount scaled by input strength and divergence
    float smoothAmt = saturate(smoothingStrength * divergence);
    if (smoothAmt <= 1e-5) return;

    // target position is the average neighbor position (mild pull)
    float3 avgPos = sumPos / valid;
    // apply a reduced fraction to avoid destroying global shape
    float3 targetWorld = avgPos;//lerp(localWorld, avgPos, smoothAmt * 0.5);
    float3 newOffset = targetWorld - localBaseVertex.position;
    // blend the final offset toward the smoothed offset
    finalOffset.positionDelta = lerp(finalOffset.positionDelta, newOffset, smoothAmt); 
}

void GetClothingIds(uint tid, out uint id, out uint idInBuffer)
{
    id = (_ClothingVertexIndexCount > 0) ? _BindingLocalIndices[tid] : tid;
    idInBuffer = id + _IndexOffset;
}

bool CalculateShapePreservingClothingVertexOffset(uint tid, out uint id, out uint idInBuffer, out int4 bindIdx, out float4 bindW, float preserveMix, out VertexData localBaseVertex, out MeshVertexDelta prevRawOffset, out MeshVertexDelta rawOffset, out MeshVertexDelta origOffset, out MeshVertexDelta finalOffset, out float averageStretch, out float tightness, out float3 thicknessVector)
{
    bindIdx = int4(-1, -1, -1, -1);
    bindW = float4(0.0, 0.0, 0.0, 0.0);
    
    localBaseVertex.position = float3(0, 0, 0);
    localBaseVertex.normal = float3(0, 0, 0);
    localBaseVertex.tangent = float4(0, 0, 0, 0);
    
    prevRawOffset.positionDelta = float3(0, 0, 0);
    prevRawOffset.normalDelta = float3(0, 0, 0);
    prevRawOffset.tangentDelta = float3(0, 0, 0);
    
    rawOffset.positionDelta = float3(0, 0, 0);
    rawOffset.normalDelta = float3(0, 0, 0);
    rawOffset.tangentDelta = float3(0, 0, 0);
    
    origOffset.positionDelta = float3(0, 0, 0);
    origOffset.normalDelta = float3(0, 0, 0);
    origOffset.tangentDelta = float3(0, 0, 0);
    
    finalOffset.positionDelta = float3(0, 0, 0);
    finalOffset.normalDelta = float3(0, 0, 0);
    finalOffset.tangentDelta = float3(0, 0, 0); 
    
    averageStretch = 1.0;
    tightness = 1.0;
    
    thicknessVector = float3(0, 0, 0);
    
    GetClothingIds(tid, id, idInBuffer);
    if (id >= _VertexCount) return false; 
    
    float4 vColor = _ClothingVertexColors[id];
    tightness = vColor.y; // 0..1, 0 = loose, 1 = tight
    
    localBaseVertex = SampleClothingVertexData(id);
    localBaseVertex.normal = normalize(localBaseVertex.normal);
    localBaseVertex.tangent.xyz = normalize(localBaseVertex.tangent.xyz);
    origOffset = SampleClothingVertexDelta(id, _IndexOffset);
    finalOffset = origOffset;
        
    bindIdx = _BindingIndices[tid];
    bindW = _BindingWeights[tid];
    
    int connCount = _VertexConnectionCounts[id];
    int connStart = _VertexConnectionStartIndices[id];
    
    // compute average stretch based on neighbor neighborhoods for stability
    float stretchSum = 0.0;
    int stretchCount = 0;
    for (int a = 0; a < connCount; a++)
    {
        WeightedVertexConnection connection = _VertexConnections[connStart + a];
        int neighborIdx = connection.index;
        if (neighborIdx < 0)
            continue;

        // neighbor base and current delta
        VertexData neighborBaseVertex = SampleClothingVertexData(neighborIdx);
        MeshVertexDelta neighborOffset = SampleClothingVertexDelta(neighborIdx, _IndexOffset);
        float3 neighborPos = neighborBaseVertex.position + neighborOffset.positionDelta;

        // compute average stretch for this neighbor across its own connections
        int nConnCount = _VertexConnectionCounts[neighborIdx];
        int nStart = _VertexConnectionStartIndices[neighborIdx];
        float neighborStretchMin = 3.402823466e+37;
        int neighborStretchCount = 0;
        for (int b = 0; b < nConnCount; b++)
        {
            int mIdx = _VertexConnections[nStart + b].index;
            if (mIdx < 0)
                continue;
            VertexData mBase = SampleClothingVertexData(mIdx);
            MeshVertexDelta mOffset = SampleClothingVertexDelta(mIdx, _IndexOffset);

            float origDist = length(neighborBaseVertex.position - mBase.position);
            float currDist = length(neighborPos - (mBase.position + mOffset.positionDelta));
            if (origDist > 1e-6)
            {
                //neighborStretchSum += currDist / origDist;
                neighborStretchMin = min(neighborStretchMin, currDist / origDist);
                neighborStretchCount++;
            }
        }

        float neighborAvg = (neighborStretchCount > 0) ? (neighborStretchMin / neighborStretchCount) : 1.0;

        // accumulate neighbor averages
        stretchSum += neighborAvg;
        stretchCount++;
    }

    // final average is the mean of neighbor averages (stable)
    averageStretch = (stretchCount > 0) ? (stretchSum / stretchCount) : 1.0;
    
    averageStretch = max(0.0, lerp(0.0, 1.0, averageStretch / 5.0)); 
    float thickness = averageStretch * _ClothThickness;
    //float3 localVertexPos = localBaseVertex.position + finalOffset.positionDelta;
    
    MeshVertexDelta weightedDelta;
    MeshVertexDelta weightedPrevDelta;
    float totalW = 0.0;
    for (int i = 0; i < 4; i++)
    {
        int idx = (i == 0) ? bindIdx.x : (i == 1) ? bindIdx.y : (i == 2) ? bindIdx.z : bindIdx.w; 
        float w = (i == 0) ? bindW.x : (i == 1) ? bindW.y : (i == 2) ? bindW.z : bindW.w;
        if (w <= 0.0)
            continue;
        if (idx < 0)
            continue;
        // bounds check (safe): if index out of range skip
        if (idx >= _BodyVertexCount)
            continue;
        
        MeshVertexDelta bodyDelta = SampleBodyDelta(idx);
        weightedDelta = MVD_Add(weightedDelta, MVD_Mul(bodyDelta, w));
        weightedPrevDelta = MVD_Add(weightedPrevDelta, MVD_Mul(SamplePreviousBodyDelta(idx), w));
        thicknessVector = thicknessVector + ((_BodyVertexNormals[idx] + bodyDelta.normalDelta) * w);
        totalW += w;
    }
    // Average weighted deltas and apply Euler rotation to align orientations between body and clothing
    if (totalW > 0.0)
    {
        weightedDelta = MVD_Div(weightedDelta, totalW);
        weightedPrevDelta = MVD_Div(weightedPrevDelta, totalW);
        thicknessVector = normalize(lerp(localBaseVertex.normal + finalOffset.normalDelta, thicknessVector / totalW, 0.75)) * thickness;
        weightedDelta.positionDelta = weightedDelta.positionDelta + thicknessVector;
        weightedPrevDelta.positionDelta = weightedPrevDelta.positionDelta + thicknessVector;
    }
    
    prevRawOffset = weightedPrevDelta;
    rawOffset = weightedDelta;

    bool isRawPass = _BodyDeltasChanged == 1;
    // If this is the first dispatch after a body update, add the weighted delta difference to the clothing offsets so clothing follows raw body changes immediately.
    if (isRawPass)
    {
        MeshVertexDelta deltaDiff = MVD_Subtract(weightedDelta, weightedPrevDelta);
        finalOffset = MVD_Lerp(MVD_Add(origOffset, deltaDiff), MVD_Mul(weightedDelta, _DeltaMultiplier), 1.0); //lerp(0.1, 0.9, tightness)); 
    }
    else
    {
        finalOffset = MVD_Lerp(origOffset, MVD_Mul(weightedDelta, _DeltaMultiplier), lerp(0.001, 0.3, tightness * preserveMix));
    }
    
    MeshVertexDelta startFinalOffset = finalOffset; 
    
    //VertexData localVertex = VD_Add(localBaseVertex, localOffset);
    
    if (!isRawPass)
    {
        MeshVertexDelta editedOffset;
        editedOffset.positionDelta = float3(0, 0, 0);
        editedOffset.normalDelta = float3(0, 0, 0);
        editedOffset.tangentDelta = float3(0, 0, 0);
        float totalWeight = 0.0;
        for (int a = 0; a < connCount; a++) // calculates neighboring deltas and tries to modify the local delta to be in a similar offset as the base position relative to its neighbors 
        {
            WeightedVertexConnection connection = _VertexConnections[connStart + a];

            VertexData neighborBaseVertex = SampleClothingVertexData(connection.index);
            MeshVertexDelta neighborOffset = SampleClothingVertexDelta(connection.index, _IndexOffset);

            VertexData neighborVertex = VD_AddDelta(neighborBaseVertex, neighborOffset);
            neighborVertex.normal = normalize(neighborVertex.normal);
            neighborVertex.tangent.xyz = normalize(neighborVertex.tangent.xyz);

            float3 originalOffsetPos = localBaseVertex.position - neighborBaseVertex.position;
            float4 originalOffsetNorm = FromToRotation(neighborBaseVertex.normal, localBaseVertex.normal);
            float4 originalOffsetTan = FromToRotation(neighborBaseVertex.tangent.xyz, localBaseVertex.tangent.xyz);
            float originalDistance = length(originalOffsetPos);

            float4 shapeOffsetRot = FromToRotation(neighborBaseVertex.normal, neighborVertex.normal);

            float3 startNeighborVertexPos = neighborVertex.position;
            neighborVertex.position = neighborVertex.position + Rotate(shapeOffsetRot, originalOffsetPos);
            neighborVertex.normal = Rotate(originalOffsetNorm, neighborVertex.normal);
            neighborVertex.tangent.xyz = Rotate(originalOffsetTan, neighborVertex.tangent.xyz);

            float3 offsetWithDeltas = neighborVertex.position - startNeighborVertexPos; // localPos - neighborPos after new deltas applied.
            float offsetDist = length(offsetWithDeltas);
            if (offsetDist > 0.0)
                neighborVertex.position = lerp(neighborVertex.position, ((neighborVertex.position - localBaseVertex.position) * (originalDistance / offsetDist)) + localBaseVertex.position, 0.05 * tightness); // try to blend back to original distance between vertices to avoid stretching the mesh too much
        
            float cWeight = connection.weight; // * connectionMaskWeight;
            editedOffset.positionDelta = editedOffset.positionDelta + (neighborVertex.position - localBaseVertex.position) * cWeight;
            editedOffset.normalDelta = editedOffset.normalDelta + (neighborVertex.normal - localBaseVertex.normal) * cWeight;
            editedOffset.tangentDelta = editedOffset.tangentDelta + (neighborVertex.tangent.xyz - localBaseVertex.tangent.xyz) * cWeight; 

            totalWeight += cWeight;
        }
        totalWeight = 1.0 - min(1.0, totalWeight);
        editedOffset.positionDelta = editedOffset.positionDelta + finalOffset.positionDelta * totalWeight;
        editedOffset.normalDelta = editedOffset.normalDelta + finalOffset.normalDelta * totalWeight;
        editedOffset.tangentDelta = editedOffset.tangentDelta + finalOffset.tangentDelta * totalWeight;

        float mix = _PreserveFactor; // * maskWeight;
        finalOffset.positionDelta = lerp(startFinalOffset.positionDelta, lerp(finalOffset.positionDelta, editedOffset.positionDelta, mix), preserveMix);
        finalOffset.normalDelta = lerp(startFinalOffset.normalDelta, lerp(finalOffset.normalDelta, editedOffset.normalDelta, mix), preserveMix);
        finalOffset.tangentDelta = lerp(startFinalOffset.tangentDelta, lerp(finalOffset.tangentDelta, editedOffset.tangentDelta, mix), preserveMix); 
    }

    return true;
}

void CalculateClothVertexOffset(uint tid, uint id, uint idInBuffer, int4 bindIdx, float4 bindW, VertexData localBaseVertex, MeshVertexDelta origOffset, inout MeshVertexDelta finalOffset)
{
    // Start with the current offset from the previous iteration/frame
    //finalOffset = origOffset;
    
    int connCount = _VertexConnectionCounts[id];
    int connStart = _VertexConnectionStartIndices[id];
    
    // 1. Establish current position of this vertex in the iteration
    float3 currentPos = localBaseVertex.position + finalOffset.positionDelta;
    float3 totalCorrection = float3(0, 0, 0);

    for (int a = 0; a < connCount; a++)
    {
        WeightedVertexConnection connection = _VertexConnections[connStart + a];

        // 2. Fetch neighbor data
        VertexData neighborBaseVertex = SampleClothingVertexData(connection.index);
        MeshVertexDelta neighborOffset = SampleClothingVertexDelta(connection.index, _IndexOffset); 
        float3 neighborCurrentPos = neighborBaseVertex.position + neighborOffset.positionDelta;

        // 3. Compute vector between vertices
        float3 deltaPos = neighborCurrentPos - currentPos;
        float currentDistance = length(deltaPos);
        
        if (currentDistance > 0.0001)
        {
            // Rest length represents the original tailored garment distance
            float restLength = length(neighborBaseVertex.position - localBaseVertex.position);
            
            // 4. Calculate Distance Error (Hooke's Law / PBD)
            float error = currentDistance - restLength;
            float3 direction = deltaPos / currentDistance;
            
            // 5. Accumulate raw correction. 
            // In a pure PBD solver, each vertex moves 50% toward resolving the constraint if weights are equal.
            float cWeight = connection.weight;
            totalCorrection += direction * error * 0.5 * cWeight;
        }
    }

    // 6. Apply iterative relaxation
    if (connCount > 0)
    {
        // Divide by the number of connections so the vertex doesn't over-correct and explode
        float3 finalCorrection = totalCorrection / (float) connCount;
        
        // _PreserveFactor controls the convergence rate per iteration (Keep between 0.1 and 0.5 for stability)
        float relaxationRate = _PreserveFactor;
        
        finalOffset.positionDelta += finalCorrection * relaxationRate;
    }
}

void ApplyClothPullPass2(uint id, VertexData localBaseVertex, inout MeshVertexDelta finalOffset, float clothBlendOut, float currentStretch)
{
    int connCount = _VertexConnectionCounts[id];
    if (connCount == 0)
        return;
    
    int connStart = _VertexConnectionStartIndices[id];
    
    // Read the current frame's baseline delta
    float3 currentPos = localBaseVertex.position + finalOffset.positionDelta;
    
    float3 neighborPositionSum = float3(0, 0, 0);
    float totalWeight = 0.0;

    // Gather absolute neighbor positions from the source snapshot
    for (int a = 0; a < connCount; a++)
    {
        WeightedVertexConnection connection = _VertexConnections[connStart + a];

        VertexData neighborBaseVertex = SampleClothingVertexData(connection.index);
        MeshVertexDelta neighborOffset = SampleClothingVertexDelta(connection.index, _IndexOffset);
        float3 neighborCurrentPos = neighborBaseVertex.position + neighborOffset.positionDelta;

        float cWeight = connection.weight;
        neighborPositionSum += neighborCurrentPos * cWeight;
        totalWeight += cWeight;
    }

    if (totalWeight <= 0.0001)
    {
        return;
    }

    // Calculate the raw spatial center of all surrounding neighbors
    float3 averageNeighborPos = neighborPositionSum / totalWeight;
    
    // This vector represents 100% of the distance required to completely flatten the local mesh
    float3 displacementVector = averageNeighborPos - currentPos;

    // Inverse cloth blend out: tightness = 1.0 cancels everything, tightness = 0.0 is full cloth
    float clothInfluence = saturate(1.0 - clothBlendOut);
    
    // Hyper-aggressive multiplier: 1.0 forcefully snaps the vertex to the exact center of its neighbors
    float smoothingForce = 0.8 * clothInfluence / clamp(currentStretch, 0.5, 3.0);  
    
    // Apply the raw displacement vector additively to our current position
    float3 absoluteSmoothedPos = currentPos + (displacementVector * smoothingForce);
    
    // Convert back into a fresh local delta (meters)
    float3 newPositionDelta = absoluteSmoothedPos - localBaseVertex.position;

    // High ceiling safety threshold (50 centimeters max change per pass)
    float maxSafeMovement = 0.5;
    float3 totalShift = newPositionDelta - finalOffset.positionDelta;
    if (length(totalShift) > maxSafeMovement)
    {
        newPositionDelta = finalOffset.positionDelta + (normalize(totalShift) * maxSafeMovement);
    }

    // Explicitly write back out to the target buffer
    finalOffset.positionDelta = newPositionDelta; 
}

void ApplyClothPullPass3(uint id, VertexData localBaseVertex, inout MeshVertexDelta finalOffset, float clothBlendOut, float clothMult, float currentStretch)
{
    int connCount = _VertexConnectionCounts[id];
    if (connCount == 0)
        return;
    
    int connStart = _VertexConnectionStartIndices[id];
    
    float3 currentPos = localBaseVertex.position + finalOffset.positionDelta;
    float3 currentNormal = normalize(localBaseVertex.normal + finalOffset.normalDelta);
    
    float3 neighborPositionSum = float3(0, 0, 0);
    float totalWeight = 0.0;

    for (int a = 0; a < connCount; a++)
    {
        WeightedVertexConnection connection = _VertexConnections[connStart + a];

        VertexData neighborBaseVertex = SampleClothingVertexData(connection.index);
        MeshVertexDelta neighborOffset = SampleClothingVertexDelta(connection.index, _IndexOffset);
        float3 neighborCurrentPos = neighborBaseVertex.position + neighborOffset.positionDelta;

        float cWeight = connection.weight;
        neighborPositionSum += neighborCurrentPos * cWeight;
        totalWeight += cWeight;
    }

    if (totalWeight <= 0.0001)
        return;

    float3 averageNeighborPos = neighborPositionSum / totalWeight;
    float3 displacementVector = averageNeighborPos - currentPos;

    float clothInfluence = saturate(1.0 - clothBlendOut) * clothMult;
    
    // BOOST 1: Successive Over-Relaxation Multiplier. 
    // Moving this above 1.0 (e.g., 1.4) acts like a predictive engine, 
    // forcing the vertex to pre-travel further down the pipeline.
    float overRelaxationFactor = 1.2;
    float smoothingForce = overRelaxationFactor * clothInfluence * clamp(currentStretch, 0.5, 2);
    
    // Calculate the raw over-relaxed step
    float3 rawBoostedShift = displacementVector * smoothingForce;

    // BOOST 2: Anisotropic Stabilizer (The Spike Killer)
    // We split the hyper-force into sliding (tangent) and flattening (normal) vectors.
    float normalShiftDistance = dot(rawBoostedShift, currentNormal);
    float3 normalShift = currentNormal * normalShiftDistance;
    float3 tangentShift = rawBoostedShift - normalShift;

    // We let horizontal sliding run at 100% maximum boosted speed,
    // but dampen the normal axis slightly to completely prevent exploding spikes.
    float3 stabilizedShift = tangentShift + (normalShift * 0.6);

    // Apply the stabilized, over-relaxed displacement
    float3 absoluteSmoothedPos = currentPos + stabilizedShift;
    float3 newPositionDelta = absoluteSmoothedPos - localBaseVertex.position;

    // Dynamic Safe Ceiling: Scales based on local mesh strain
    float maxSafeMovement = 0.25 * clamp(currentStretch, 0.8, 1.5); 
    float3 totalShift = newPositionDelta - finalOffset.positionDelta;
    
    if (length(totalShift) > maxSafeMovement)
    {
        newPositionDelta = finalOffset.positionDelta + (normalize(totalShift) * maxSafeMovement);
    }

    finalOffset.positionDelta = newPositionDelta;
}

void ApplyClothPullPass4(uint id, VertexData localBaseVertex, inout MeshVertexDelta finalOffset, float clothBlendOut, float clothMult, float currentStretch)
{
    int connCount = _VertexConnectionCounts[id];
    if (connCount == 0)
        return;
    
    int connStart = _VertexConnectionStartIndices[id];
    
    float3 currentPos = localBaseVertex.position + finalOffset.positionDelta;
    float3 currentNormal = normalize(localBaseVertex.normal + finalOffset.normalDelta);
    
    // Accumulators for standard Laplacian smoothing
    float3 neighborPositionSum = float3(0, 0, 0);
    
    // HC ADDITION: Accumulators to calculate the average deformation vector of neighbors
    float3 neighborOriginalDiffSum = float3(0, 0, 0);
    
    float totalWeight = 0.0;

    // --- First Loop: Gather Neighbor Data ---
    for (int a = 0; a < connCount; a++)
    {
        WeightedVertexConnection connection = _VertexConnections[connStart + a];

        VertexData neighborBaseVertex = SampleClothingVertexData(connection.index);
        MeshVertexDelta neighborOffset = SampleClothingVertexDelta(connection.index, _IndexOffset);
        
        float3 neighborCurrentPos = neighborBaseVertex.position + neighborOffset.positionDelta;
        // The distance this neighbor has deviated from its original base shape
        float3 neighborOriginalDiff = neighborCurrentPos - neighborBaseVertex.position;

        float cWeight = connection.weight;
        
        neighborPositionSum += neighborCurrentPos * cWeight;
        neighborOriginalDiffSum += neighborOriginalDiff * cWeight; // HC Track
        totalWeight += cWeight;
    }

    if (totalWeight <= 0.0001)
        return;

    // Compute averages
    float3 averageNeighborPos = neighborPositionSum / totalWeight;
    float3 averageNeighborDiff = neighborOriginalDiffSum / totalWeight;

    // --- HC Math Engine ---
    // Standard Laplacian displacement vector
    float3 laplacianDisplacement = averageNeighborPos - currentPos;

    // Current vertex deviation from its base shape
    float3 currentOriginalDiff = currentPos - localBaseVertex.position;

    // HC Tuning Parameters
    // Alpha: Controls how fast the mesh relaxes/smooths (0.0 to 1.0)
    float alpha = saturate(1.0 - clothBlendOut) * clothMult * 0.5;
    
    // Beta: Controls volume preservation (0.0 means standard Laplacian, 0.95 means extreme anti-shrinkage)
    // 0.85 is the industry sweet spot for keeping thin straps/fingers intact
    float beta = 0.85;

    // The core HC Equation:
    // It pushes the vertex toward the average neighbor position, but subtracts a fraction
    // of how much the neighborhood is already collapsing toward the center.
    float3 hcShift = (alpha * laplacianDisplacement) + (1.0 - beta) * (currentOriginalDiff - averageNeighborDiff);

    // --- Over-Relaxation & Stabilization ---
    float overRelaxationFactor = 1.2;
    float3 rawBoostedShift = hcShift * overRelaxationFactor * clamp(currentStretch, 0.5, 2.0);

    // Anisotropic Stabilizer: Filter normal axis to prevent mesh exploding
    float normalShiftDistance = dot(rawBoostedShift, currentNormal);
    float3 normalShift = currentNormal * normalShiftDistance;
    float3 tangentShift = rawBoostedShift - normalShift;

    // Keep 100% of tangent sliding, but slightly dampen normal axis adjustments
    float3 stabilizedShift = tangentShift + (normalShift * 0.6);

    // Apply the final displacement
    float3 absoluteSmoothedPos = currentPos + stabilizedShift;
    float3 newPositionDelta = absoluteSmoothedPos - localBaseVertex.position;

    // Dynamic Safe Ceiling: Scales based on local mesh strain
    float maxSafeMovement = 0.25 * clamp(currentStretch, 0.8, 1.5);
    float3 totalShift = newPositionDelta - finalOffset.positionDelta;
    
    if (length(totalShift) > maxSafeMovement)
    {
        newPositionDelta = finalOffset.positionDelta + (normalize(totalShift) * maxSafeMovement);
    }

    finalOffset.positionDelta = newPositionDelta;
}

void ApplyClothPullPass8(uint id, VertexData localBaseVertex, inout MeshVertexDelta finalOffset, float clothBlendOut, float clothMult, float currentStretch)
{
    int connCount = _VertexConnectionCounts[id];
    if (connCount == 0)
        return;
    
    int connStart = _VertexConnectionStartIndices[id];
    
    float3 currentPos = localBaseVertex.position + finalOffset.positionDelta;
    float3 currentNormal = normalize(localBaseVertex.normal + finalOffset.normalDelta);
    
    float3 neighborPositionSum = float3(0, 0, 0);
    float3 neighborOriginalDiffSum = float3(0, 0, 0);
    float totalWeight = 0.0;
    float neighborConnSum = 0.0;

    float baseDistanceSum = 0.0;
    float currentDistanceSum = 0.0;

    // --- Second Loop: Gather Neighbor Data ---
    for (int a = 0; a < connCount; a++)
    {
        WeightedVertexConnection connection = _VertexConnections[connStart + a];

        VertexData neighborBaseVertex = SampleClothingVertexData(connection.index);
        MeshVertexDelta neighborOffset = SampleClothingVertexDelta(connection.index, _IndexOffset);
        
        float3 neighborCurrentPos = neighborBaseVertex.position + neighborOffset.positionDelta;
        float3 neighborOriginalDiff = neighborCurrentPos - neighborBaseVertex.position;

        float baseDist = distance(localBaseVertex.position, neighborBaseVertex.position);
        float currentDist = distance(currentPos, neighborCurrentPos);
        
        baseDistanceSum += baseDist;
        currentDistanceSum += currentDist;

        int neighborConnCount = _VertexConnectionCounts[connection.index];
        neighborConnSum += (float) neighborConnCount;

        float neighborWeightModifier = (neighborConnCount < 5) ? 0.75 : 1.0;
        float cWeight = connection.weight * neighborWeightModifier;
        
        neighborPositionSum += neighborCurrentPos * cWeight;
        neighborOriginalDiffSum += neighborOriginalDiff * cWeight;
        totalWeight += cWeight;
    }

    if (totalWeight <= 0.0001)
        return;

    float3 averageNeighborPos = neighborPositionSum / totalWeight;
    float3 averageNeighborDiff = neighborOriginalDiffSum / totalWeight;

    // --- 1. ANALYSIS & DETECTION ---
    float avgLocalConnections = neighborConnSum / (float) connCount;
    float globalConnCheck = min((float) connCount, avgLocalConnections);
    float borderUrgency = saturate((5.0 - globalConnCheck) / 1.5);

    float averageBaseDist = baseDistanceSum / (float) connCount;
    float averageCurrentDist = currentDistanceSum / (float) connCount;
    float distanceRatio = (averageBaseDist > 0.0001) ? (averageCurrentDist / averageBaseDist) : 1.0;
    float shrinkIntensity = saturate(1.0 - distanceRatio);

    float protectionFactor = max(borderUrgency, shrinkIntensity);

    // --- 2. ACCELERATED HC ENGINE ---
    float3 laplacianDisplacement = averageNeighborPos - currentPos;
    float3 currentOriginalDiff = currentPos - localBaseVertex.position;

    float alpha = saturate(1.0 - clothBlendOut) * clothMult;
    float beta = lerp(0.85, 0.99, protectionFactor);

    // Throttle smoothing if neighbors are compressing
    alpha *= lerp(1.0, 0.15, shrinkIntensity);

    float3 hcShift = (alpha * laplacianDisplacement) + (1.0 - beta) * (currentOriginalDiff - averageNeighborDiff);

    // --- 3. ADAPTIVE OVER-RELAXATION & STABILIZATION ---
    float overRelaxationFactor = lerp(1.5, 1.3, protectionFactor);
    float3 rawBoostedShift = hcShift * overRelaxationFactor * clamp(currentStretch, 0.5, 2.0);

    // Split vectors into Tangent (sliding along length) and Normal (radial thickness) axes
    float normalShiftDistance = dot(rawBoostedShift, currentNormal);
    float3 normalShift = currentNormal * normalShiftDistance;
    float3 tangentShift = rawBoostedShift - normalShift;

    // Dampen normal shift down significantly on thin geometry
    float normalDampening = lerp(0.50, 0.02, protectionFactor);
    float3 stabilizedShift = tangentShift + (normalShift * normalDampening);

    // --- 4. HARD VOLUME GATE (Ponytail Cylinder Protection) ---
    // Calculate how far the vertex has already moved away from its base position 
    // strictly along the normal axis. Negative means it has collapsed inward.
    float currentNormalDisplacement = dot(finalOffset.positionDelta, currentNormal);
    
    // Project our proposed new smoothing shift along the normal axis
    float proposedNormalShift = dot(stabilizedShift, currentNormal);
    float predictedNormalDisplacement = currentNormalDisplacement + proposedNormalShift;

    // If the vertex is thin/urgent, and the smoothing engine wants to pull it 
    // further inward (negative), we actively block or scale it back.
    if (protectionFactor > 0.5 && predictedNormalDisplacement < currentNormalDisplacement)
    {
        // Calculate a hard compression threshold. We don't want the radius 
        // to shrink past a tiny fraction of its original local edge length.
        float maxAllowedInwardCollapse = -0.05 * averageBaseDist;

        if (predictedNormalDisplacement < maxAllowedInwardCollapse)
        {
            // Zero out or reverse the inward normal force completely.
            // This forces 100% of the remaining smoothing energy to happen sideways (tangent).
            stabilizedShift -= normalShift * normalDampening;
        }
    }

    // --- 5. APPLY & CONSTRAIN ---
    float3 absoluteSmoothedPos = currentPos + stabilizedShift;
    float3 newPositionDelta = absoluteSmoothedPos - localBaseVertex.position;

    // Dynamic Safe Ceiling
    float maxSafeMovement = 0.25 * clamp(currentStretch, 0.8, 1.5);
    float3 totalShift = newPositionDelta - finalOffset.positionDelta;
    
    if (length(totalShift) > maxSafeMovement)
    {
        newPositionDelta = finalOffset.positionDelta + (normalize(totalShift) * maxSafeMovement);
    }

    finalOffset.positionDelta = newPositionDelta;
}

void ApplyClothPullPass9(uint id, VertexData localBaseVertex, inout MeshVertexDelta finalOffset, float clothBlendOut, float clothMult, float currentStretch)
{
    int connCount = _VertexConnectionCounts[id];
    if (connCount == 0)
        return;
    
    int connStart = _VertexConnectionStartIndices[id];
    
    float3 currentPos = localBaseVertex.position + finalOffset.positionDelta;
    float3 currentNormal = normalize(localBaseVertex.normal + finalOffset.normalDelta);
    
    float3 neighborPositionSum = float3(0, 0, 0);
    float3 neighborOriginalDiffSum = float3(0, 0, 0);
    float totalWeight = 0.0;
    float neighborConnSum = 0.0;

    float baseDistanceSum = 0.0;
    float currentDistanceSum = 0.0;

    // --- Second Loop: Gather Neighbor Data ---
    for (int a = 0; a < connCount; a++)
    {
        WeightedVertexConnection connection = _VertexConnections[connStart + a];

        VertexData neighborBaseVertex = SampleClothingVertexData(connection.index);
        MeshVertexDelta neighborOffset = SampleClothingVertexDelta(connection.index, _IndexOffset);
        
        float3 neighborCurrentPos = neighborBaseVertex.position + neighborOffset.positionDelta;
        float3 neighborOriginalDiff = neighborCurrentPos - neighborBaseVertex.position;

        float baseDist = distance(localBaseVertex.position, neighborBaseVertex.position);
        float currentDist = distance(currentPos, neighborCurrentPos);
        
        baseDistanceSum += baseDist;
        currentDistanceSum += currentDist;

        int neighborConnCount = _VertexConnectionCounts[connection.index];
        neighborConnSum += (float) neighborConnCount;

        float neighborWeightModifier = (neighborConnCount < 5) ? 0.75 : 1.0;
        float cWeight = connection.weight * neighborWeightModifier;
        
        neighborPositionSum += neighborCurrentPos * cWeight;
        neighborOriginalDiffSum += neighborOriginalDiff * cWeight;
        totalWeight += cWeight;
    }

    if (totalWeight <= 0.0001)
        return;

    float3 averageNeighborPos = neighborPositionSum / totalWeight;
    float3 averageNeighborDiff = neighborOriginalDiffSum / totalWeight;

    // --- 1. ANALYSIS & DETECTION ---
    float avgLocalConnections = neighborConnSum / (float) connCount;
    float globalConnCheck = min((float) connCount, avgLocalConnections);
    float borderUrgency = saturate((5.0 - globalConnCheck) / 1.5);

    float averageBaseDist = baseDistanceSum / (float) connCount;
    float averageCurrentDist = currentDistanceSum / (float) connCount;
    float distanceRatio = (averageBaseDist > 0.0001) ? (averageCurrentDist / averageBaseDist) : 1.0;
    float shrinkIntensity = saturate(1.0 - distanceRatio);

    float protectionFactor = max(borderUrgency, shrinkIntensity);

    // --- 2. ACCELERATED HC ENGINE ---
    float3 laplacianDisplacement = averageNeighborPos - currentPos;
    float3 currentOriginalDiff = currentPos - localBaseVertex.position;

    float alpha = saturate(1.0 - clothBlendOut) * clothMult;
    float beta = lerp(0.85, 0.99, protectionFactor);

    // Throttle smoothing if neighbors are compressing
    alpha *= lerp(1.0, 0.15, shrinkIntensity);

    float3 hcShift = (alpha * laplacianDisplacement) + (1.0 - beta) * (currentOriginalDiff - averageNeighborDiff);

    // --- 3. ADAPTIVE OVER-RELAXATION & STABILIZATION ---
    float overRelaxationFactor = lerp(1.5, 1.3, protectionFactor);
    float3 rawBoostedShift = hcShift * overRelaxationFactor * clamp(currentStretch, 0.5, 2.0);

    // Split vectors into Tangent (sliding on surface) and Normal (flattening) axes
    float normalShiftDistance = dot(rawBoostedShift, currentNormal);
    float3 normalShift = currentNormal * normalShiftDistance;
    float3 surfaceTangentShift = rawBoostedShift - normalShift;

    // Dampen normal shift down significantly on thin geometry
    float normalDampening = lerp(0.50, 0.02, protectionFactor);
    float3 stabilizedShift = surfaceTangentShift + (normalShift * normalDampening);

    // --- 4. NEW: LOCAL RIBBON WIDTH FILTER (Flat Strip Protection) ---
    // If we are on a narrow ribbon mesh, we must prevent vertices from pulling inward 
    // along the strip's short width axis, while keeping smoothing active along its long length axis.
    if (protectionFactor > 0.5)
    {
        // Find the primary direction the laplacian vector wants to pull this vertex.
        // On a ribbon edge, the laplacian pulls directly inward across the width of the strip.
        float3 inwardWidthDir = normalize(laplacianDisplacement);

        // Calculate a longitudinal length axis that is perpendicular to both the surface normal 
        // and the inward width collapse vector. This axis runs safely down the length of the ponytail.
        float3 longitudinalLengthDir = normalize(cross(currentNormal, inwardWidthDir));

        // Re-align our inward width direction to be perfectly planar to the mesh tangent surface
        float3 pureWidthTangent = normalize(cross(longitudinalLengthDir, currentNormal));

        // Isolate how much of our proposed smoothing shift is trying to narrow the strip's width
        float widthShiftDistance = dot(stabilizedShift, pureWidthTangent);
        float3 widthShiftVector = pureWidthTangent * widthShiftDistance;

        // Strip out the narrowing force entirely based on our protection factor.
        // This stops the strip from collapsing into a needle, but leaves 100% of the 
        // longitudinal shift intact so the ponytail relaxes smoothly down its length.
        stabilizedShift -= widthShiftVector * protectionFactor;
    }

    // --- 5. APPLY & CONSTRAIN ---
    float3 absoluteSmoothedPos = currentPos + stabilizedShift;
    float3 newPositionDelta = absoluteSmoothedPos - localBaseVertex.position;

    // Dynamic Safe Ceiling
    float maxSafeMovement = 0.25 * clamp(currentStretch, 0.8, 1.5);
    float3 totalShift = newPositionDelta - finalOffset.positionDelta;
    
    if (length(totalShift) > maxSafeMovement)
    {
        newPositionDelta = finalOffset.positionDelta + (normalize(totalShift) * maxSafeMovement);
    }

    finalOffset.positionDelta = newPositionDelta;
}

void ApplyClothPullPass(uint id, VertexData localBaseVertex, inout MeshVertexDelta finalOffset, float clothBlendOut, float clothMult, float currentStretch)
{
    int connCount = _VertexConnectionCounts[id];
    if (connCount == 0)
        return;
    
    int connStart = _VertexConnectionStartIndices[id];
    
    float3 currentPos = localBaseVertex.position + finalOffset.positionDelta;
    float3 currentNormal = normalize(localBaseVertex.normal + finalOffset.normalDelta);
    
    float3 neighborPositionSum = float3(0, 0, 0);
    float3 neighborOriginalDiffSum = float3(0, 0, 0);
    float totalWeight = 0.0;
    float neighborConnSum = 0.0;

    float baseDistanceSum = 0.0;
    float currentDistanceSum = 0.0;

    // DIRECT DISTANCE PUSH-BACK TRACKER:
    // Accumulates vectors pushing away from neighbors that have compressed too close.
    float3 pushBackSum = float3(0, 0, 0);

    // --- Second Loop: Gather Neighbor Data ---
    for (int a = 0; a < connCount; a++)
    {
        WeightedVertexConnection connection = _VertexConnections[connStart + a];

        VertexData neighborBaseVertex = SampleClothingVertexData(connection.index);
        MeshVertexDelta neighborOffset = SampleClothingVertexDelta(connection.index, _IndexOffset);
        
        float3 neighborCurrentPos = neighborBaseVertex.position + neighborOffset.positionDelta;
        float3 neighborOriginalDiff = neighborCurrentPos - neighborBaseVertex.position;

        // Calculate exact edge lengths between this vertex and the current neighbor
        float baseDist = distance(localBaseVertex.position, neighborBaseVertex.position);
        float currentDist = distance(currentPos, neighborCurrentPos);
        
        baseDistanceSum += baseDist;
        currentDistanceSum += currentDist;

        // --- NEW: INDIVIDUAL EDGE COMPRESSION CHECK ---
        // If the current simulated distance is smaller than the original base distance, 
        // the neighbor is encroaching and causing shrinkage. 
        if (currentDist < baseDist)
        {
            float3 pushDir = currentPos - neighborCurrentPos;
            float pushLen = length(pushDir);
            
            if (pushLen > 0.0001)
            {
                // Move in the exact opposite direction of the neighbor
                pushDir /= pushLen;
                
                // The push force is perfectly proportional to the compression deficit
                float compressionDeficit = baseDist - currentDist;
                
                // Accumulate the directional push-back force scaled by connection weight
                pushBackSum += pushDir * compressionDeficit * connection.weight;
            }
        }

        int neighborConnCount = _VertexConnectionCounts[connection.index];
        neighborConnSum += (float) neighborConnCount;

        float neighborWeightModifier = (neighborConnCount < 5) ? 0.75 : 1.0;
        float cWeight = connection.weight * neighborWeightModifier;
        
        neighborPositionSum += neighborCurrentPos * cWeight;
        neighborOriginalDiffSum += neighborOriginalDiff * cWeight;
        totalWeight += cWeight;
    }

    if (totalWeight <= 0.0001)
        return;

    float3 averageNeighborPos = neighborPositionSum / totalWeight;
    float3 averageNeighborDiff = neighborOriginalDiffSum / totalWeight;
    
    // Average out our collected push-back forces
    float3 averagePushBack = pushBackSum / totalWeight;

    // --- 1. ANALYSIS & DETECTION ---
    float avgLocalConnections = neighborConnSum / (float) connCount;
    float globalConnCheck = min((float) connCount, avgLocalConnections);
    float borderUrgency = saturate((5.0 - globalConnCheck) / 1.5);

    float averageBaseDist = baseDistanceSum / (float) connCount;
    float averageCurrentDist = currentDistanceSum / (float) connCount;
    float distanceRatio = (averageBaseDist > 0.0001) ? (averageCurrentDist / averageBaseDist) : 1.0;
    float shrinkIntensity = saturate(1.0 - distanceRatio);

    float protectionFactor = max(borderUrgency, shrinkIntensity);

    // --- 2. ACCELERATED HC ENGINE ---
    float3 laplacianDisplacement = averageNeighborPos - currentPos;
    float3 currentOriginalDiff = currentPos - localBaseVertex.position; 

    float alpha = saturate(1.0 - clothBlendOut) * clothMult;
    float beta = lerp(0.85, 0.99, protectionFactor);

    // Throttle smoothing if neighbors are compressing
    alpha *= lerp(1.0, 0.15, shrinkIntensity);

    float3 hcShift = (alpha * laplacianDisplacement) + (1.0 - beta) * (currentOriginalDiff - averageNeighborDiff);

    // --- NEW: INJECT PUSH-BACK FORCE ---
    // We add our self-calculated, directional push-back force directly into the shift vector.
    // It naturally scales up or down based on individual neighbor compression levels without gating.
    hcShift += averagePushBack * 1.5; // 1.5 multiplier gives the restoration force dominant authority

    // --- 3. ADAPTIVE OVER-RELAXATION & STABILIZATION ---
    float overRelaxationFactor = lerp(1.5, 1.3, protectionFactor);
    float3 rawBoostedShift = hcShift * overRelaxationFactor * clamp(currentStretch, 0.5, 2.0);

    // Split vectors into Tangent (sliding on surface) and Normal (flattening) axes
    float normalShiftDistance = dot(rawBoostedShift, currentNormal);
    float3 normalShift = currentNormal * normalShiftDistance;
    float3 surfaceTangentShift = rawBoostedShift - normalShift;

    // Dampen normal shift down significantly on thin geometry
    float normalDampening = lerp(0.50, 0.02, protectionFactor);
    float3 stabilizedShift = surfaceTangentShift + (normalShift * normalDampening);

    // --- 4. APPLY & CONSTRAIN ---
    float3 absoluteSmoothedPos = currentPos + stabilizedShift;
    float3 newPositionDelta = absoluteSmoothedPos - localBaseVertex.position;

    // Dynamic Safe Ceiling
    float maxSafeMovement = 0.25 * clamp(currentStretch, 0.8, 1.5);
    float3 totalShift = newPositionDelta - finalOffset.positionDelta;
    
    if (length(totalShift) > maxSafeMovement)
    {
        newPositionDelta = finalOffset.positionDelta + (normalize(totalShift) * maxSafeMovement);
    }

    finalOffset.positionDelta = newPositionDelta;
}

[numthreads(256, 1, 1)]
void ApplyVertexDeltas(uint3 dtid : SV_DispatchThreadID) 
{
    //uint tid = dtid.x;
    //if (tid >= _VertexCount)
        return;

    //_ClothingVertexDeltas[tid] = VD_AddDelta(SampleClothingVertexData(tid), _ClothingVertexDeltasReadOnly[_IndexOffset + tid]);
